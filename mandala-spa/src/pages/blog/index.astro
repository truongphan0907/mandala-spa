---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Mandala from '../../components/Mandala.astro';
import { formatDate } from '../../lib/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Blog sống khỏe – Massage, dưỡng sinh, chăm sóc da" description="Kiến thức massage trị liệu, dưỡng sinh Đông y, chăm sóc da và sống khỏe mỗi ngày từ Mandala Buôn Ma Thuột.">
  <PageHero eyebrow="Blog" title="Blog Mandala – Sống khỏe mỗi ngày" text="Kiến thức massage, dưỡng sinh Đông y, chăm sóc da và những thói quen nhỏ cho cơ thể khỏe mạnh." />
  <section class="section">
    <div class="container-x grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((p) => (
        <a href={`/blog/${p.id}/`} class="group flex flex-col overflow-hidden rounded-2xl border border-line bg-ivory transition hover:shadow-xl hover:shadow-espresso/5">
          <div class="aspect-[16/10] overflow-hidden bg-sand">
            {p.data.image ? (
              <Picture src={p.data.image} alt={p.data.imageAlt} widths={[400, 700]} sizes="(min-width: 1024px) 380px, (min-width: 768px) 50vw, 100vw"
                       formats={['avif', 'webp']} class="h-full w-full object-cover transition duration-700 group-hover:scale-105" />
            ) : <div class="flex h-full items-center justify-center"><Mandala class="h-24 w-24 text-gold/60" stroke={2.5} /></div>}
          </div>
          <div class="flex flex-1 flex-col p-5">
            <p class="text-xs tracking-[0.12em] text-muted uppercase">{p.data.category} · {formatDate(p.data.date)}</p>
            <h2 class="mt-2 text-[24px] group-hover:text-bronze">{p.data.title}</h2>
            <p class="mt-2 text-[15px] text-muted">{p.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
