---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Blog sức khỏe" description="Kiến thức massage, thư giãn và chăm sóc sức khỏe từ Mandala Spa & Massage.">
  <section class="bg-sand/50 py-16 text-center md:py-20">
    <div class="container-x">
      <p class="eyebrow">Góc sức khỏe</p>
      <h1 class="mt-3 text-5xl md:text-6xl">Blog</h1>
    </div>
  </section>
  <section class="py-16">
    <div class="container-x grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((p) => (
        <a href={`/blog/${p.id}`} class="group rounded-2xl border border-bark/10 bg-white/50 p-6 transition hover:shadow-lg">
          <p class="text-xs text-ink/50">{p.data.date.toLocaleDateString('vi-VN')}</p>
          <h2 class="mt-2 text-2xl font-semibold group-hover:text-gold">{p.data.title}</h2>
          <p class="mt-2 text-sm text-ink/70">{p.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
