---
import { Picture, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import info from '../../data/info.json';
import { formatDate } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const og = post.data.image ? await getImage({ src: post.data.image, width: 1200, height: 630, format: 'jpg', fit: 'cover' }) : undefined;
const related = (await getCollection('blog', ({ data, id }) => !data.draft && id !== post.id)).slice(0, 2);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  image: og ? new URL(og.src, Astro.site).toString() : undefined,
  author: { '@type': 'Organization', name: info.name },
  publisher: { '@type': 'Organization', name: info.name, logo: { '@type': 'ImageObject', url: new URL('/icon-512.png', Astro.site).toString() } },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
};
---
<Base title={post.data.title} description={post.data.description} type="article" ogImage={og?.src} schema={schema}>
  <article>
    <header class="bg-sand/60">
      <div class="container-x max-w-3xl py-10 md:py-16">
        <nav aria-label="Đường dẫn" class="text-sm text-muted"><a href="/" class="hover:text-bronze">Trang chủ</a> / <a href="/blog/" class="hover:text-bronze">Blog</a></nav>
        <p class="eyebrow mt-6">{post.data.category}</p>
        <h1 class="mt-3 text-[36px] md:text-[52px]">{post.data.title}</h1>
        <p class="mt-4 text-sm text-muted">Mandala · {formatDate(post.data.date)}</p>
      </div>
    </header>
    {post.data.image && (
      <div class="container-x -mt-2 max-w-4xl pt-8">
        <Picture src={post.data.image} alt={post.data.imageAlt} widths={[480, 800, 1200]} sizes="(min-width: 960px) 896px, 100vw"
                 formats={['avif', 'webp']} loading="eager" fetchpriority="high" class="aspect-[16/9] w-full rounded-[2rem] object-cover" />
      </div>
    )}
    <div class="container-x max-w-3xl py-10 md:py-14">
      <div class="prose-mandala"><Content /></div>
      <div class="mt-12 rounded-2xl border border-line bg-ivory p-6 text-center md:p-8">
        <p class="font-serif text-2xl text-cocoa">Muốn được tư vấn liệu trình phù hợp?</p>
        <p class="mt-2 text-muted">Nhắn Zalo hoặc gọi {info.phone} – Mandala tư vấn miễn phí.</p>
        <div class="mt-5 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="/lien-he/#dat-lich" class="btn-primary">Đặt lịch ngay</a>
          <a href={info.zalo} target="_blank" rel="noopener" class="btn-ghost">Chat Zalo</a>
        </div>
      </div>
      {related.length > 0 && (
        <div class="mt-12 border-t border-line pt-8">
          <p class="text-sm font-medium tracking-[0.12em] text-muted uppercase">Đọc thêm</p>
          <ul class="mt-3 space-y-2">
            {related.map((r) => <li><a href={`/blog/${r.id}/`} class="font-medium text-cocoa underline-offset-4 hover:underline">{r.data.title}</a></li>)}
          </ul>
        </div>
      )}
    </div>
  </article>
  <CtaBand />
</Base>
