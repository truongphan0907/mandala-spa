---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBand from '../components/CtaBand.astro';
import ExpertBanner from '../components/ExpertBanner.astro';
import services from '../data/services.json';
import info from '../data/info.json';
---
<Base title="Dịch vụ spa & dưỡng sinh tại Buôn Ma Thuột"
      description="Massage trị liệu, gội đầu dưỡng sinh, liệu pháp Đông y Cung phẩm Ngự Y và chăm sóc da tại Mandala – 86 Hàn Mặc Tử, Buôn Ma Thuột.">
  <PageHero eyebrow="Dịch vụ" title="Dịch vụ tại Mandala"
            text="Mỗi cơ thể có một câu chuyện riêng. Mandala mang đến bốn nhóm liệu trình, từ thư giãn nhẹ nhàng đến trị liệu chuyên sâu, để bạn chọn đúng điều cơ thể đang cần." />

  <ExpertBanner />
  <section class="section">
    <div class="container-x grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {services.groups.map((g) => <ServiceCard group={g} />)}
    </div>
  </section>

  <section class="section bg-sand/60">
    <div class="container-x">
      <p class="eyebrow">Gợi ý nhanh</p>
      <h2 class="h2 mt-3">Bạn đang gặp vấn đề gì?</h2>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {services.groups.map((g) => (
          <a href={`/dich-vu/${g.slug}/`} class="flex items-center justify-between gap-4 rounded-2xl border border-line bg-ivory p-5 hover:border-bronze">
            <span><span class="block text-muted">{g.need}</span><span class="font-serif text-2xl text-cocoa">→ {g.title}</span></span>
          </a>
        ))}
      </div>
      <div class="mt-10 rounded-2xl bg-ivory p-6 text-center md:p-8">
        <p class="font-serif text-2xl text-cocoa">Chưa biết chọn liệu trình nào?</p>
        <p class="mt-2 text-muted">Nhắn Zalo mô tả tình trạng của bạn, Mandala sẽ tư vấn miễn phí.</p>
        <a href={info.zalo} target="_blank" rel="noopener" class="btn-primary mt-5">Tư vấn qua Zalo</a>
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
