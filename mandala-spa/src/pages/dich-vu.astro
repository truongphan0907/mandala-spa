---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import services from '../data/services.json';
---
<Base title="Dịch vụ & Bảng giá" description="Bảng giá massage body, đá nóng, foot massage, gội đầu dưỡng sinh và các gói combo tại Mandala Spa & Massage.">
  <section class="bg-sand/50 py-16 text-center md:py-24">
    <div class="container-x">
      <p class="eyebrow">Menu trị liệu</p>
      <h1 class="mt-3 text-5xl md:text-6xl">Dịch vụ & Bảng giá</h1>
      <p class="mx-auto mt-4 max-w-xl text-ink/70">Giá đã bao gồm trà thảo mộc và khăn nóng. Vui lòng đặt lịch trước để được phục vụ tốt nhất.</p>
      <nav class="mt-8 flex flex-wrap justify-center gap-2">
        {services.map((c, i) => <a href={`#nhom-${i}`} class="btn-ghost !py-2">{c.category}</a>)}
      </nav>
    </div>
  </section>

  {services.map((c, i) => (
    <section id={`nhom-${i}`} class="scroll-mt-24 py-14">
      <div class="container-x">
        <h2 class="text-4xl">{c.category}</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {c.items.map((s) => <ServiceCard {...s} />)}
        </div>
      </div>
    </section>
  ))}

  <section class="pb-20 text-center">
    <a href="/lien-he#dat-lich" class="btn-primary">Đặt lịch ngay</a>
  </section>
</Base>
