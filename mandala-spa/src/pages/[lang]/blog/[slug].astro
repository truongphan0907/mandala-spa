---
// Trang bài blog tiếng nước ngoài
import { Picture, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { FOREIGN, ui, url, blogUrl, bookUrl, getInfo, type Lang } from '../../../i18n';

export async function getStaticPaths() {
  const posts = await getCollection('blogIntl', ({ id, data }) => !data.draft && FOREIGN.includes(id.split('/')[0] as any));
  return posts.map((post) => {
    const [lang, slug] = post.id.split('/');
    return { params: { lang, slug }, props: { post } };
  });
}
const { post } = Astro.props;
const lang = Astro.params.lang as Lang;
const t = ui(lang);
const info = getInfo(lang);
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString(t.blog.locale, { year: 'numeric', month: 'long', day: 'numeric' });
const og = post.data.image ? await getImage({ src: post.data.image, width: 1200, height: 630, format: 'jpg', fit: 'cover' }) : undefined;
const related = (await getCollection('blogIntl', ({ id, data }) => !data.draft && id.startsWith(lang + '/') && id !== post.id)).slice(0, 3);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  inLanguage: lang,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  image: og ? new URL(og.src, Astro.site).toString() : undefined,
  author: { '@type': 'Organization', name: info.name },
  publisher: { '@type': 'Organization', name: info.name, logo: { '@type': 'ImageObject', url: new URL('/icon-512.png', Astro.site).toString() } },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
};
---
<Base title={post.data.title} description={post.data.description} type="article" ogImage={og?.src} schema={schema}>
  <article>
    <header class="bg-sand/60">
      <div class="container-x max-w-3xl py-10 md:py-16">
        <nav aria-label={t.breadcrumb} class="text-sm text-muted"><a href={url(lang, 'home')} class="hover:text-bronze">{t.nav.home}</a> / <a href={url(lang, 'blog')} class="hover:text-bronze">{t.blog.eyebrow}</a></nav>
        <p class="eyebrow mt-6">{post.data.category}</p>
        <h1 class="mt-3 text-[34px] md:text-[50px]">{post.data.title}</h1>
        <p class="mt-4 text-sm text-muted">Mandala · {fmt(post.data.date)}</p>
      </div>
    </header>
    {post.data.image && (
      <div class="container-x -mt-2 max-w-4xl pt-8">
        <Picture src={post.data.image} alt={post.data.imageAlt} widths={[480, 800, 1200]} sizes="(min-width: 960px) 896px, 100vw"
                 formats={['avif', 'webp']} loading="eager" fetchpriority="high" class="aspect-[16/9] w-full rounded-[2rem] object-cover" />
      </div>
    )}
    <div class="container-x max-w-3xl py-10 md:py-14">
      <div class="prose-mandala"><Content /></div>
      <div class="mt-12 rounded-2xl border border-line bg-ivory p-6 text-center md:p-8">
        <p class="font-serif text-2xl text-cocoa">{t.blog.ctaTitle}</p>
        <p class="mt-2 text-muted">{t.blog.ctaText.replace('{phone}', info.phone)}</p>
        <div class="mt-5 flex flex-col justify-center gap-3 sm:flex-row">
          <a href={bookUrl(lang)} class="btn-primary">{t.bookNow}</a>
          <a href={`tel:${info.phoneRaw}`} class="btn-ghost">{t.call} {info.phone}</a>
        </div>
      </div>
      {related.length > 0 && (
        <div class="mt-12 border-t border-line pt-8">
          <p class="text-sm font-medium tracking-[0.12em] text-muted uppercase">{t.blog.readMore}</p>
          <ul class="mt-3 space-y-2">
            {related.map((r) => <li><a href={blogUrl(lang, r.id.split('/')[1])} class="font-medium text-cocoa underline-offset-4 hover:underline">{r.data.title}</a></li>)}
          </ul>
        </div>
      )}
    </div>
  </article>
  <CtaBand />
</Base>
