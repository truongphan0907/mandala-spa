---
import Base from '../layouts/Base.astro';
import Mandala from '../components/Mandala.astro';
---
<Base title="Không tìm thấy trang">
  <section class="container-x flex flex-col items-center py-28 text-center">
    <Mandala class="h-28 w-28 text-gold" />
    <h1 class="mt-6 text-5xl">Không tìm thấy trang</h1>
    <p class="mt-3 text-ink/70">Trang bạn tìm có thể đã được di chuyển. Hãy quay về trang chủ nhé.</p>
    <a href="/" class="btn-primary mt-8">Về trang chủ</a>
  </section>
</Base>
