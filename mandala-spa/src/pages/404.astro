---
import Base from '../layouts/Base.astro';
import Mandala from '../components/Mandala.astro';
---
<Base title="Không tìm thấy trang" noindex>
  <section class="container-x flex flex-col items-center py-24 text-center md:py-32">
    <Mandala class="h-28 w-28 text-gold" stroke={2.5} />
    <h1 class="mt-6 text-[44px]">Không tìm thấy trang</h1>
    <p class="mt-3 max-w-md text-muted">Trang bạn tìm có thể đã được di chuyển. Bạn quay về trang chủ hoặc xem bảng giá nhé.</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="btn-primary">Về trang chủ</a>
      <a href="/bang-gia/" class="btn-ghost">Xem bảng giá</a>
    </div>
  </section>
</Base>
