---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import BookingForm from '../components/BookingForm.astro';
import info from '../data/info.json';
---
<Base title="Liên hệ & đặt lịch – Mandala Spa Buôn Ma Thuột"
      description={`Đặt lịch spa tại Mandala – ${info.address}. Hotline/Zalo ${info.phone}. Mở cửa ${info.hoursShort}.`}>
  <PageHero eyebrow="Liên hệ" title="Đặt lịch & Liên hệ"
            text="Đặt lịch trước để Mandala chuẩn bị phòng và kỹ thuật viên phù hợp. Chúng tôi sẽ gọi xác nhận trong giờ mở cửa." />

  <section class="section">
    <div class="container-x grid gap-10 lg:grid-cols-[1.3fr_1fr] lg:gap-14">
      <div id="dat-lich" class="scroll-mt-24 rounded-[2rem] border border-line bg-ivory p-6 md:p-10">
        <h2 class="text-[32px]">Đặt lịch online</h2>
        <p class="mt-1 mb-8 text-[15px] text-muted">Các ô có dấu * là bắt buộc.</p>
        <BookingForm />
      </div>

      <div class="space-y-8">
        <div>
          <p class="eyebrow">Địa chỉ</p>
          <p class="mt-2 text-lg"><a href={info.mapLink} target="_blank" rel="noopener" class="underline decoration-1 underline-offset-4 hover:opacity-80">{info.address}</a></p>
          <a href={info.mapLink} target="_blank" rel="noopener" class="mt-1 inline-block font-medium text-bronze underline-offset-4 hover:underline">Chỉ đường Google Maps →</a>
        </div>
        <div>
          <p class="eyebrow">Giờ mở cửa</p>
          {info.hours.map((h) => <p class="mt-2 text-lg">{h.days}: <strong class="font-medium text-cocoa">{h.time}</strong></p>)}
        </div>
        <div>
          <p class="eyebrow">Liên hệ nhanh</p>
          <div class="mt-3 flex flex-wrap gap-2">
            <a href={`tel:${info.phoneRaw}`} class="btn-primary">Gọi {info.phone}</a>
            <a href={info.zalo} target="_blank" rel="noopener" class="btn-ghost">Zalo</a>
            <a href={info.messenger} target="_blank" rel="noopener" class="btn-ghost">Messenger</a>
            <a href={info.facebook} target="_blank" rel="noopener" class="btn-ghost">Facebook</a>
          </div>
        </div>
        <iframe src={info.mapEmbedUrl} title="Bản đồ đường đến Mandala" class="aspect-[4/3] w-full rounded-2xl border-0 bg-sand"
                loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>
</Base>
