---
import Base from '../layouts/Base.astro';
import Mandala from '../components/Mandala.astro';

const team = [
  { name: 'Chị Hoa', role: 'Trưởng kỹ thuật viên · 10 năm kinh nghiệm' },
  { name: 'Anh Tuấn', role: 'Chuyên viên trị liệu cơ – xương' },
  { name: 'Chị Mai', role: 'Chuyên viên massage đá nóng & foot' },
];
---
<Base title="Giới thiệu" description="Câu chuyện, triết lý chăm sóc và đội ngũ kỹ thuật viên của Mandala Spa & Massage.">
  <section class="relative overflow-hidden py-16 md:py-24">
    <Mandala class="pointer-events-none absolute -left-32 top-0 h-[30rem] w-[30rem] text-gold/10" />
    <div class="container-x relative grid gap-12 md:grid-cols-2 md:items-center">
      <div>
        <p class="eyebrow">Về chúng tôi</p>
        <h1 class="mt-3 text-5xl md:text-6xl">Mandala – vòng tròn của sự cân bằng</h1>
        <div class="mt-6 space-y-4 leading-relaxed text-ink/75">
          <p>Mandala là biểu tượng của sự trọn vẹn và hài hòa. Chúng tôi chọn cái tên này vì tin rằng một buổi trị liệu tốt không chỉ làm cơ thể nhẹ nhõm, mà còn giúp tâm trí lắng lại.</p>
          <p>Mỗi liệu trình tại Mandala Spa bắt đầu bằng việc lắng nghe: bạn mệt ở đâu, ngủ thế nào, cần nhẹ hay sâu. Từ đó kỹ thuật viên điều chỉnh lực và động tác cho riêng bạn.</p>
          <p class="text-sm text-ink/50">(Đoạn giới thiệu mẫu – thay bằng câu chuyện thật của spa.)</p>
        </div>
      </div>
      <div class="photo-placeholder aspect-[4/5] rounded-3xl"></div>
    </div>
  </section>

  <section class="bg-sand/50 py-20">
    <div class="container-x">
      <p class="eyebrow">Đội ngũ</p>
      <h2 class="mt-3 text-4xl md:text-5xl">Những đôi tay tận tâm</h2>
      <div class="mt-10 grid gap-8 sm:grid-cols-2 md:grid-cols-3">
        {team.map((m) => (
          <div class="text-center">
            <div class="photo-placeholder mx-auto aspect-square w-48 rounded-full"></div>
            <h3 class="mt-4 text-2xl font-semibold">{m.name}</h3>
            <p class="text-sm text-ink/60">{m.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="container-x">
      <p class="eyebrow">Không gian</p>
      <h2 class="mt-3 text-4xl md:text-5xl">Thư viện ảnh</h2>
      <!-- Thay bằng ảnh thật trong public/images/ -->
      <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-3">
        {Array.from({ length: 6 }).map((_, i) => (
          <div class:list={['photo-placeholder rounded-2xl', i % 3 === 0 ? 'aspect-[3/4]' : 'aspect-square']}></div>
        ))}
      </div>
    </div>
  </section>
</Base>
