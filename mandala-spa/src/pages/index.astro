---
import { Picture, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Mandala from '../components/Mandala.astro';
import ServiceCard from '../components/ServiceCard.astro';
import BookingForm from '../components/BookingForm.astro';
import info from '../data/info.json';
import home from '../data/home.json';
import services from '../data/services.json';
import { img, vnd } from '../lib/site';

const featured = services.groups.flatMap((g) => g.items.filter((i) => i.featured).map((i) => ({ ...i, group: g.title, slug: g.slug })));
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const heroImg = img(home.heroImage)!;
const insetImg = img(home.heroInsetImage)!;

// Ảnh hero: bản dọc (cắt sẵn) cho điện thoại, bản khung vòm 4:5 cho máy tính
const heroMobile = img(home.heroMobileImage)!;
const crop = async (w: number, ratio: number, format: 'avif' | 'webp' | 'jpg', src = heroImg) =>
  getImage({ src, width: w, height: Math.round(w * ratio), fit: 'cover', position: 'center', format });
const set = async (ws: number[], ratio: number, format: 'avif' | 'webp' | 'jpg', src = heroImg) =>
  (await Promise.all(ws.map(async (w) => `${(await crop(w, ratio, format, src)).src} ${w}w`))).join(', ');
const mob = { avif: await set([480, 800, 1000], 1.75, 'avif', heroMobile), webp: await set([480, 800, 1000], 1.75, 'webp', heroMobile) };
const desk = { avif: await set([560, 840, 1120], 1.25, 'avif'), webp: await set([560, 840, 1120], 1.25, 'webp') };
const fallback = await crop(840, 1.25, 'jpg');
---
<Base>
  <!-- 1. HERO – mobile: ảnh nền toàn màn; desktop: chia đôi chữ / ảnh khung vòm -->
  <section class="relative isolate overflow-hidden lg:bg-cream">
    <Mandala class="pointer-events-none absolute -top-40 -left-40 hidden h-[34rem] w-[34rem] text-gold/12 lg:block" petals={16} />
    <div class="lg:container-x lg:grid lg:min-h-[min(calc(100svh-72px-78px),760px)] lg:grid-cols-[1.08fr_1fr] lg:items-center lg:gap-16 lg:py-10">
      <div class="absolute inset-0 -z-10 lg:relative lg:inset-auto lg:z-0 lg:order-2 lg:w-fit lg:justify-self-end">
        <picture>
          <source media="(max-width: 1023px)" type="image/avif" srcset={mob.avif} sizes="100vw" />
          <source media="(max-width: 1023px)" type="image/webp" srcset={mob.webp} sizes="100vw" />
          <source type="image/avif" srcset={desk.avif} sizes="520px" />
          <source type="image/webp" srcset={desk.webp} sizes="520px" />
          <img src={fallback.src} alt={home.heroImageAlt} width="840" height="1050" loading="eager" fetchpriority="high" decoding="async"
               class="h-full w-full object-cover lg:aspect-[4/5] lg:h-[min(640px,calc(100svh-240px))] lg:w-auto lg:rounded-t-[999px] lg:rounded-b-[2rem] lg:shadow-2xl lg:shadow-espresso/20" />
        </picture>
        <div class="absolute inset-0 bg-gradient-to-t from-espresso via-espresso/55 to-espresso/5 lg:hidden"></div>
        <div class="absolute -bottom-6 -left-10 hidden h-40 w-40 overflow-hidden rounded-full border-[6px] border-cream shadow-xl lg:block xl:h-48 xl:w-48">
          <Picture src={insetImg} alt={home.heroInsetAlt} widths={[200, 400]} sizes="192px" formats={['avif', 'webp']} class="h-full w-full object-cover" />
        </div>
      </div>

      <div class="container-x flex min-h-[min(calc(100svh-56px-60px),860px)] flex-col justify-end pt-24 pb-8 lg:min-h-0 lg:max-w-none lg:px-0 lg:py-0">
        <p class="text-[13px] font-medium tracking-[0.18em] text-goldlight uppercase lg:text-bronze">{info.eyebrow}</p>
        <h1 class="mt-3 text-[40px] text-cream sm:text-5xl lg:text-[68px] lg:text-cocoa xl:text-[76px]">
          Tĩnh tâm –<br />Thư giãn –<br /><em class="font-medium text-goldlight lg:text-bronze">Phục hồi sức khỏe</em>
        </h1>
        <p class="mt-4 text-[15px] text-sand lg:hidden">{home.heroServicesLine}</p>
        <p class="mt-6 hidden max-w-lg text-[18px] text-muted lg:block">{home.heroDescription}</p>
        <div class="mt-6 grid grid-cols-2 gap-3 sm:flex lg:mt-9">
          <a href="/lien-he/#dat-lich" class="btn bg-goldlight text-espresso hover:bg-cream lg:bg-cocoa lg:text-cream lg:hover:bg-espresso">Đặt lịch ngay</a>
          <a href="/bang-gia/" class="btn-light lg:border-cocoa/35 lg:text-cocoa lg:hover:bg-cocoa lg:hover:text-cream">Xem bảng giá</a>
        </div>
        <p class="mt-5 text-sm text-sand/90 lg:hidden">Mở cửa {info.hoursShort} · Giá từ {info.priceFrom}</p>
      </div>
    </div>

    <!-- Dải thông tin nhanh (desktop) -->
    <div class="hidden border-t border-line bg-ivory lg:block">
      <div class="container-x grid grid-cols-4 divide-x divide-line text-[15px]">
        <a href={info.mapLink} target="_blank" rel="noopener" class="flex items-center gap-3 py-5 pr-4 hover:text-bronze">
          <span class="text-bronze" aria-hidden="true">◎</span><span><span class="block text-xs text-muted">Địa chỉ</span>{info.addressShort}</span>
        </a>
        <p class="flex items-center gap-3 px-6 py-5"><span class="text-bronze" aria-hidden="true">◷</span><span><span class="block text-xs text-muted">Mở cửa hằng ngày</span>{info.hoursShort}</span></p>
        <a href={`tel:${info.phoneRaw}`} class="flex items-center gap-3 px-6 py-5 hover:text-bronze"><span class="text-bronze" aria-hidden="true">✆</span><span><span class="block text-xs text-muted">Hotline / Zalo</span><span class="font-medium">{info.phone}</span></span></a>
        <a href={info.mapLink} target="_blank" rel="noopener" class="flex items-center gap-3 px-6 py-5 hover:text-bronze">
          <span class="text-bronze" aria-hidden="true">★</span>
          <span><span class="block text-xs text-muted">Đánh giá Google</span>{info.googleRating ? `${info.googleRating}/5 (${info.googleReviewCount} đánh giá)` : 'Xem cảm nhận của khách'}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 2. BỐN TRỤ CỘT DỊCH VỤ -->
  <section class="section">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow">Dịch vụ</p>
        <h2 class="h2 mt-3">{home.pillarsTitle}</h2>
        <p class="mt-4 text-muted">{home.pillarsIntro}</p>
      </div>
    </div>
    <div class="mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-4 [scrollbar-width:none] md:container-x md:mt-12 md:grid md:grid-cols-2 md:gap-6 md:overflow-visible md:pb-0 lg:grid-cols-4">
      {services.groups.map((g) => (
        <div class="w-[78%] shrink-0 snap-start sm:w-[46%] md:w-auto"><ServiceCard group={g} /></div>
      ))}
    </div>
  </section>

  <!-- 3. LIỆU PHÁP ĐẶC TRƯNG -->
  <section class="section bg-sand/60">
    <div class="container-x grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <Picture src={img(home.signature.image)!} alt={home.signature.imageAlt} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 560px, 100vw"
               formats={['avif', 'webp']} class="aspect-square w-full rounded-[2rem] object-cover" />
      <div>
        <p class="eyebrow">{home.signature.eyebrow}</p>
        <h2 class="h2 mt-3">{home.signature.title}</h2>
        <p class="mt-5 text-muted">{home.signature.text}</p>
        <ul class="mt-6 space-y-3">
          {home.signature.points.map((p) => (
            <li class="flex gap-3"><Mandala class="mt-1 h-5 w-5 shrink-0 text-gold" petals={8} stroke={7} /><span>{p}</span></li>
          ))}
        </ul>
        <a href="/dich-vu/dong-y-duong-sinh/" class="btn-primary mt-8">Xem liệu trình Ngự Y</a>
      </div>
    </div>
  </section>

  <!-- 4. HÀNH TRÌNH TRẢI NGHIỆM + CAM KẾT -->
  <section class="section">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.15fr] lg:gap-16">
      <div class="lg:order-2">
        <p class="eyebrow">Trải nghiệm tại Mandala</p>
        <h2 class="h2 mt-3">{home.journey.title}</h2>
        <ol class="mt-8 space-y-6">
          {home.journey.steps.map((s, i) => (
            <li class="flex gap-5">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-gold/60 font-serif text-xl text-bronze">{i + 1}</span>
              <div><h3 class="text-2xl">{s.title}</h3><p class="mt-1 text-muted">{s.text}</p></div>
            </li>
          ))}
        </ol>
      </div>
      <Picture src={img(home.journey.image)!} alt={home.journey.imageAlt} widths={[480, 800, 1100]} sizes="(min-width: 1024px) 480px, 100vw"
               formats={['avif', 'webp']} class="aspect-[4/5] w-full rounded-[2rem] object-cover lg:aspect-auto lg:h-full" />
    </div>
    <div class="container-x mt-12 grid gap-4 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
      {home.journey.promises.map((p) => (
        <div class="rounded-2xl border border-line bg-ivory p-5">
          <h3 class="text-[22px]">{p.title}</h3>
          <p class="mt-1 text-[15px] text-muted">{p.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 5. LIỆU TRÌNH NỔI BẬT + COMBO -->
  <section class="section bg-sand/60">
    <div class="container-x grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-14">
      <div>
        <p class="eyebrow">Gợi ý cho bạn</p>
        <h2 class="h2 mt-3">{home.featuredTitle}</h2>
        <ul class="mt-8 divide-y divide-line rounded-2xl border border-line bg-ivory">
          {featured.map((f) => (
            <li>
              <a href={`/dich-vu/${f.slug}/`} class="flex items-center justify-between gap-4 px-5 py-4 hover:bg-cream md:px-6">
                <span><span class="block text-xs tracking-[0.12em] text-muted uppercase">{f.group}</span><span class="font-medium">{f.name}</span></span>
                <span class="text-lg font-medium whitespace-nowrap text-bronze">{vnd(f.price)}</span>
              </a>
            </li>
          ))}
        </ul>
        <a href="/bang-gia/" class="mt-6 inline-block font-medium text-cocoa underline underline-offset-4">Xem bảng giá đầy đủ →</a>
      </div>
      <div class="overflow-hidden rounded-[2rem] bg-espresso text-cream">
        <Picture src={img(home.comboImage)!} alt={home.comboImageAlt} widths={[480, 800]} sizes="(min-width: 1024px) 480px, 100vw"
                 formats={['avif', 'webp']} class="aspect-[16/10] w-full object-cover" />
        <div class="p-6 md:p-8">
          <p class="text-[13px] font-medium tracking-[0.18em] text-goldlight uppercase">Combo hoàn hảo</p>
          <ul class="mt-4 space-y-4">
            {services.combos.map((c) => (
              <li class="flex items-baseline justify-between gap-4 border-b border-cream/10 pb-4">
                <span class="font-serif text-2xl">{c.name}</span>
                <span class="text-lg font-medium whitespace-nowrap text-goldlight">{vnd(c.price)}</span>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-[15px] text-sand/80">Món quà ý nghĩa cho người thân, cặp đôi. Nhắn Zalo để được tư vấn chi tiết liệu trình.</p>
          <a href={info.zalo} target="_blank" rel="noopener" class="btn mt-6 bg-goldlight text-espresso hover:bg-cream">Tư vấn qua Zalo</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. KHÔNG GIAN -->
  <section class="section">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow">Không gian</p>
        <h2 class="h2 mt-3">{home.space.title}</h2>
        <p class="mt-4 text-muted">{home.space.text}</p>
      </div>
      <div class="mt-8 grid grid-cols-2 gap-3 md:mt-12 md:grid-cols-3 md:gap-5">
        {home.space.images.map((s) => (
          <figure class="group relative overflow-hidden rounded-2xl">
            <Picture src={img(s.src)!} alt={s.alt} widths={[360, 600, 800]} sizes="(min-width: 768px) 33vw, 50vw" formats={['avif', 'webp']}
                     class="aspect-square w-full object-cover transition duration-700 group-hover:scale-105" />
            <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-espresso/80 to-transparent px-3 pt-8 pb-2.5 text-sm text-cream md:px-4 md:text-[15px]">{s.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. KHÁCH HÀNG NÓI GÌ -->
  <section class="section bg-espresso text-cream">
    <div class="container-x">
      <p class="text-[13px] font-medium tracking-[0.18em] text-goldlight uppercase">Cảm nhận</p>
      <h2 class="h2 mt-3 text-cream">{home.reviewsTitle}</h2>
      {home.reviews.length > 0 ? (
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {home.reviews.map((r: { name: string; text: string }) => (
            <figure class="rounded-2xl bg-cream/5 p-6 ring-1 ring-cream/10">
              <p class="text-goldlight" aria-label="5 sao">★★★★★</p>
              <blockquote class="mt-3 font-serif text-xl leading-snug italic">“{r.text}”</blockquote>
              <figcaption class="mt-4 text-sm text-sand/70">— {r.name}</figcaption>
            </figure>
          ))}
        </div>
      ) : (
        <p class="mt-4 max-w-2xl text-sand/80">{home.reviewsIntro}</p>
      )}
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={info.mapLink} target="_blank" rel="noopener" class="btn bg-goldlight text-espresso hover:bg-cream">Xem đánh giá trên Google</a>
        <a href={info.facebook} target="_blank" rel="noopener" class="btn-light">Theo dõi Facebook</a>
      </div>
    </div>
  </section>

  <!-- 8. ĐẶT LỊCH + BẢN ĐỒ -->
  <section class="section" id="dat-lich-nhanh">
    <div class="container-x grid gap-10 lg:grid-cols-[1.25fr_1fr] lg:gap-14">
      <div class="rounded-[2rem] border border-line bg-ivory p-6 md:p-10">
        <p class="eyebrow">Đặt lịch</p>
        <h2 class="h2 mt-3">{home.ctaTitle}</h2>
        <p class="mt-3 mb-8 text-muted">{home.ctaText}</p>
        <BookingForm />
      </div>
      <div class="flex flex-col gap-6">
        <div>
          <p class="eyebrow">Ghé thăm Mandala</p>
          <p class="mt-3 font-serif text-2xl text-cocoa">{info.address}</p>
          <p class="mt-2 text-muted">Mở cửa {info.hours[0].days.toLowerCase()}: {info.hoursShort}</p>
          <p class="mt-1">Hotline / Zalo: <a href={`tel:${info.phoneRaw}`} class="font-medium text-cocoa">{info.phone}</a></p>
        </div>
        <iframe src={info.mapEmbedUrl} title="Bản đồ đường đến Mandala" class="min-h-72 w-full flex-1 rounded-2xl border-0 bg-sand" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        <a href={info.mapLink} target="_blank" rel="noopener" class="btn-ghost">Chỉ đường Google Maps</a>
      </div>
    </div>
    {posts.length > 0 && (
      <div class="container-x mt-14 border-t border-line pt-8">
        <p class="text-sm font-medium tracking-[0.12em] text-muted uppercase">Bài viết mới trên Blog</p>
        <ul class="mt-3 grid gap-2 md:grid-cols-3 md:gap-6">
          {posts.map((p) => <li><a href={`/blog/${p.id}/`} class="font-medium text-cocoa underline-offset-4 hover:underline">{p.data.title}</a></li>)}
        </ul>
      </div>
    )}
  </section>
</Base>
