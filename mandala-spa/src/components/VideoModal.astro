---
// Cửa sổ xem video toàn màn hình (có tiếng) + nút Đặt lịch. Dùng chung cho mọi trang.
// Đồng thời: chỉ cho video thẻ chạy khi hiện trên màn hình.
import { getLang, ui, bookUrl } from '../i18n';
import videos from '../data/videos.json';
const lang = getLang(Astro.url);
const t = ui(lang);
// Nút đặt lịch trong video: dẫn tới form đúng ngôn ngữ, chọn sẵn liệu trình (theo tên tiếng Việt)
const bookBase = bookUrl(lang).replace('#dat-lich', '');
---
<div id="video-modal" class="fixed inset-0 z-[100] hidden flex-col items-center justify-center gap-4 bg-espresso px-4 pt-16 pb-[calc(1.25rem+env(safe-area-inset-bottom))]"
     role="dialog" aria-modal="true" aria-label={t.video.dialog}>
  <button id="vm-close" type="button" class="absolute top-[calc(0.75rem+env(safe-area-inset-top))] right-4 flex h-11 w-11 items-center justify-center rounded-full bg-cream text-cocoa" aria-label={t.video.close}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <!-- Video chiếm phần còn lại, nút Đặt lịch nằm riêng bên dưới – không che thanh điều khiển -->
  <div class="flex min-h-0 w-full flex-1 items-center justify-center">
    <video id="vm-video" class="aspect-[9/16] max-h-full max-w-full rounded-2xl bg-black object-contain" playsinline controls></video>
  </div>
  <a id="vm-book" href={bookUrl(lang)} class="btn shrink-0 bg-goldlight whitespace-nowrap text-espresso hover:bg-cream" data-track="video_book">{t.video.book}</a>
</div>

<script is:inline define:vars={{ videos, bookBase }}>
  (function () {
    const map = Object.fromEntries(videos.map((v) => [v.id, v]));
    const dlg = document.getElementById('video-modal');
    const vid = document.getElementById('vm-video');
    const book = document.getElementById('vm-book');
    const reduce = !!(navigator.connection && navigator.connection.saveData);

    // Tự chạy video thẻ khi vào màn hình, dừng khi ra khỏi
    const io = 'IntersectionObserver' in window && !reduce && new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        const v = e.target;
        if (e.isIntersecting) { v.play().catch(() => {}); } else { v.pause(); }
      });
    }, { threshold: 0.6 });
    document.querySelectorAll('.video-card video').forEach((v) => io && io.observe(v));

    // Ảnh bìa video chỉ tải khi thẻ video sắp hiện trên màn hình (giúp trang đầu tải nhanh hơn)
    const setPoster = (v) => { if (v.dataset.poster) { v.poster = v.dataset.poster; delete v.dataset.poster; } };
    const pio = 'IntersectionObserver' in window && new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { setPoster(e.target); pio.unobserve(e.target); } });
    }, { rootMargin: '300px 0px' });
    document.querySelectorAll('.video-card video[data-poster]').forEach((v) => (pio ? pio.observe(v) : setPoster(v)));

    document.addEventListener('click', (ev) => {
      const card = ev.target.closest && ev.target.closest('[data-video]');
      if (card && dlg.contains(card)) return;
      if (!card || !dlg) return;
      const v = map[card.dataset.video] || {};
      vid.src = '/videos/' + card.dataset.video + '.mp4';
      vid.poster = '/videos/' + card.dataset.video + '.jpg';
      vid.muted = false;
      book.href = v.service ? bookBase + '?dv=' + encodeURIComponent(v.service) + '#dat-lich' : bookBase + '#dat-lich';
      dlg.classList.replace('hidden', 'flex');
      document.documentElement.style.overflow = 'hidden';
      vid.play().catch(() => {});
      (window.dataLayer = window.dataLayer || []).push({ event: 'video_open', video_id: card.dataset.video });
    });
    const close = () => {
      vid.pause(); vid.removeAttribute('src'); vid.load();
      dlg.classList.replace('flex', 'hidden');
      document.documentElement.style.overflow = '';
    };
    document.getElementById('vm-close').addEventListener('click', close);
    dlg.addEventListener('click', (e) => { if (e.target === dlg || e.target === vid.parentElement) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && dlg.classList.contains('flex')) close(); });
  })();
</script>
