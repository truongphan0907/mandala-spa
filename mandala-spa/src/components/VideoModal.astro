---
// Cửa sổ xem video toàn màn hình (có tiếng) + nút Đặt lịch. Dùng chung cho mọi trang.
// Đồng thời: chỉ cho video thẻ chạy khi hiện trên màn hình.
import videos from '../data/videos.json';
---
<dialog id="video-modal" class="m-auto max-h-none max-w-none bg-transparent p-0 backdrop:bg-espresso/90">
  <div class="relative flex h-[100svh] w-screen items-center justify-center p-4">
    <div class="relative aspect-[9/16] h-full max-h-[86svh] max-w-full">
      <video id="vm-video" class="h-full w-full rounded-2xl bg-black object-contain" playsinline controls></video>
    </div>
    <button id="vm-close" type="button" class="absolute top-4 right-4 flex h-11 w-11 items-center justify-center rounded-full bg-cream text-cocoa" aria-label="Đóng video">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <a id="vm-book" href="/lien-he/#dat-lich" class="btn absolute bottom-6 left-1/2 -translate-x-1/2 bg-goldlight text-espresso shadow-xl hover:bg-cream" data-track="video_book">Đặt lịch liệu trình này</a>
  </div>
</dialog>

<script is:inline define:vars={{ videos }}>
  (function () {
    const map = Object.fromEntries(videos.map((v) => [v.id, v]));
    const dlg = document.getElementById('video-modal');
    const vid = document.getElementById('vm-video');
    const book = document.getElementById('vm-book');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches || (navigator.connection && navigator.connection.saveData);

    // Tự chạy video thẻ khi vào màn hình, dừng khi ra khỏi
    const io = 'IntersectionObserver' in window && !reduce && new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        const v = e.target;
        if (e.isIntersecting) { v.play().catch(() => {}); } else { v.pause(); }
      });
    }, { threshold: 0.6 });
    document.querySelectorAll('.video-card video').forEach((v) => io && io.observe(v));

    document.addEventListener('click', (ev) => {
      const card = ev.target.closest && ev.target.closest('[data-video]');
      if (!card || !dlg) return;
      const v = map[card.dataset.video] || {};
      vid.src = '/videos/' + card.dataset.video + '.mp4';
      vid.poster = '/videos/' + card.dataset.video + '.jpg';
      vid.muted = false;
      book.href = v.service ? '/lien-he/?dv=' + encodeURIComponent(v.service) + '#dat-lich' : '/lien-he/#dat-lich';
      dlg.showModal();
      vid.play().catch(() => {});
      (window.dataLayer = window.dataLayer || []).push({ event: 'video_open', video_id: card.dataset.video });
    });
    const close = () => { vid.pause(); vid.removeAttribute('src'); vid.load(); dlg.close(); };
    document.getElementById('vm-close').addEventListener('click', close);
    dlg.addEventListener('click', (e) => { if (e.target === dlg || e.target === dlg.firstElementChild) close(); });
    dlg.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
  })();
</script>
