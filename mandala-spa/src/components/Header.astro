---
import info from '../data/info.json';
const nav = [
  { href: '/', label: 'Trang chủ' },
  { href: '/dich-vu', label: 'Dịch vụ & Bảng giá' },
  { href: '/gioi-thieu', label: 'Giới thiệu' },
  { href: '/blog', label: 'Blog' },
  { href: '/lien-he', label: 'Liên hệ' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="sticky top-0 z-40 border-b border-bark/10 bg-cream/90 backdrop-blur">
  <div class="container-x flex h-16 items-center justify-between md:h-20">
    <a href="/" class="flex items-center gap-2">
      <img src="/favicon.svg" alt="" width="32" height="32" class="h-8 w-8" />
      <span class="font-serif text-xl font-semibold text-bark md:text-2xl">{info.shortName}</span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Menu chính">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['text-sm transition hover:text-gold', isActive(item.href) ? 'text-gold font-medium' : 'text-bark']}
        >{item.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href={`tel:${info.phoneRaw}`} class="hidden text-sm font-medium text-bark md:block">{info.phone}</a>
      <a href="/lien-he#dat-lich" class="btn-primary hidden !py-2.5 sm:inline-flex">Đặt lịch</a>
      <button id="menu-btn" class="p-2 text-bark lg:hidden" aria-label="Mở menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 7h18M3 12h18M3 17h18" /></svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-bark/10 bg-cream lg:hidden" aria-label="Menu di động">
    <div class="container-x flex flex-col py-3">
      {nav.map((item) => (
        <a href={item.href} class:list={['py-3 text-base', isActive(item.href) ? 'text-gold' : 'text-bark']}>{item.label}</a>
      ))}
      <a href="/lien-he#dat-lich" class="btn-primary my-3">Đặt lịch ngay</a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
