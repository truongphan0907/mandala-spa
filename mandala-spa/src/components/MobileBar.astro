---
// Thanh hành động cố định ở đáy màn hình điện thoại.
// Tiếng Việt: Gọi – Zalo – Đặt lịch. Tiếng nước ngoài (khách ít dùng Zalo): Gọi – Chỉ đường – Đặt lịch.
import { getLang, getInfo, ui, bookUrl } from '../i18n';
const lang = getLang(Astro.url);
const t = ui(lang);
const info = getInfo(lang);
const vi = lang === 'vi';
---
<nav class="fixed inset-x-0 bottom-0 z-50 border-t border-line bg-ivory/97 pb-[env(safe-area-inset-bottom)] backdrop-blur lg:hidden" aria-label={t.quickContact}>
  <div class="grid h-[60px] grid-cols-3 text-[13px] font-medium">
    <a href={`tel:${info.phoneRaw}`} class="flex flex-col items-center justify-center gap-0.5 text-cocoa">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
      {t.callNow}
    </a>
    {vi ? (
      <a href={info.zalo} target="_blank" rel="noopener" class="flex flex-col items-center justify-center gap-0.5 border-x border-line text-cocoa">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 20l1.3-3.9A8.5 8.5 0 1 1 7.7 19.4L3 20"/><path d="M8.5 9.5h4l-4 5h4M15 9.5v5"/></svg>
        {t.chatZalo}
      </a>
    ) : (
      <a href={info.mapLink} target="_blank" rel="noopener" class="flex flex-col items-center justify-center gap-0.5 border-x border-line text-cocoa">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
        {t.directions}
      </a>
    )}
    <a href={bookUrl(lang)} class="flex flex-col items-center justify-center gap-0.5 bg-cocoa text-cream">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M16 3v4M8 3v4M4 11h16"/></svg>
      {t.book}
    </a>
  </div>
</nav>
