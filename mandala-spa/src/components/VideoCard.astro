---
// Thẻ video dọc 9:16 – tự chạy không tiếng khi hiện trên màn hình; bấm để xem có tiếng (VideoModal)
interface Props { id: string; title: string; label?: string; class?: string; compact?: boolean }
import { getLang, ui } from '../i18n';
const { id, title, label, class: cls = '', compact = false } = Astro.props;
const t = ui(getLang(Astro.url));
---
<button type="button" class={`video-card group relative block aspect-[9/16] w-full overflow-hidden rounded-2xl bg-espresso text-left ${cls}`}
        data-video={id} data-title={title} aria-label={`${t.video.watch} ${title}`}>
  <video class="h-full w-full object-cover" src={`/videos/${id}.mp4`} poster={`/videos/${id}.jpg`}
         muted loop playsinline preload="none" aria-hidden="true"></video>
  <span class="absolute inset-0 bg-gradient-to-t from-espresso/85 via-transparent to-transparent"></span>
  <span class:list={['absolute top-1/2 left-1/2 flex -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-cream/85 text-cocoa transition group-hover:scale-110', compact ? 'h-10 w-10' : 'h-12 w-12']}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
  </span>
  <span class:list={['absolute inset-x-0 bottom-0 text-cream', compact ? 'p-2.5' : 'p-4']}>
    {label && !compact && <span class="block text-[11px] tracking-[0.16em] text-goldlight uppercase">{label}</span>}
    <span class:list={['block font-medium', compact ? 'text-xs leading-snug' : 'mt-1 text-[15px]']}>{title}</span>
  </span>
</button>
