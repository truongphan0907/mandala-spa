---
import info from '../data/info.json';
import services from '../data/services.json';
import Mandala from './Mandala.astro';
const year = new Date().getFullYear();
---
<footer class="relative overflow-hidden bg-espresso text-sand">
  <Mandala class="pointer-events-none absolute -right-28 -bottom-28 h-96 w-96 text-goldlight/10" />
  <div class="container-x relative grid gap-10 py-14 md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <div class="flex items-center gap-3">
        <img src="/logo-mandala.svg" alt="" width="56" height="56" class="h-14 w-14" loading="lazy" />
        <div>
          <p class="font-serif text-2xl tracking-[0.08em] text-cream">MANDALA</p>
          <p class="text-xs tracking-[0.2em] text-goldlight uppercase">Healthcare & Spa</p>
        </div>
      </div>
      <p class="mt-5 font-serif text-xl text-goldlight italic">{info.tagline}</p>
    </div>

    <div class="md:col-span-3">
      <p class="mb-4 text-[13px] font-medium tracking-[0.18em] text-goldlight uppercase">Dịch vụ</p>
      <ul class="space-y-2 text-[15px]">
        {services.groups.map((g) => <li><a href={`/dich-vu/${g.slug}/`} class="hover:text-cream">{g.title}</a></li>)}
        <li><a href="/bang-gia/" class="hover:text-cream">Bảng giá</a></li>
      </ul>
    </div>

    <div class="space-y-2 text-[15px] md:col-span-5">
      <p class="mb-4 text-[13px] font-medium tracking-[0.18em] text-goldlight uppercase">Liên hệ</p>
      <p><a href={info.mapLink} target="_blank" rel="noopener" class="hover:text-cream">{info.address}</a></p>
      <p>Hotline / Zalo: <a href={`tel:${info.phoneRaw}`} class="font-medium text-cream">{info.phone}</a></p>
      {info.hours.map((h) => <p>{h.days}: <span class="text-cream">{h.time}</span></p>)}
      <div class="flex flex-wrap gap-x-5 gap-y-2 pt-3">
        <a href={info.facebook} target="_blank" rel="noopener" class="underline-offset-4 hover:text-cream hover:underline">Facebook</a>
        <a href={info.zalo} target="_blank" rel="noopener" class="underline-offset-4 hover:text-cream hover:underline">Zalo</a>
        <a href={info.mapLink} target="_blank" rel="noopener" class="underline-offset-4 hover:text-cream hover:underline">Google Maps</a>
      </div>
    </div>
  </div>
  <div class="relative border-t border-sand/10">
    <div class="container-x flex flex-col gap-2 py-5 text-[13px] text-sand/60 md:flex-row md:justify-between">
      <p>© {year} {info.name}</p>
      <p class="flex gap-4"><a href="/hoi-dap/" class="hover:text-cream">Hỏi đáp</a><a href="/chinh-sach/" class="hover:text-cream">Chính sách</a></p>
    </div>
  </div>
</footer>
