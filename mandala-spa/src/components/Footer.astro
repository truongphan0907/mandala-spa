---
import info from '../data/info.json';
import Mandala from './Mandala.astro';
const year = new Date().getFullYear();
---
<footer class="relative overflow-hidden bg-ink text-sand">
  <Mandala class="pointer-events-none absolute -right-24 -bottom-24 h-96 w-96 text-gold/10" />
  <div class="container-x relative grid gap-10 py-16 md:grid-cols-3">
    <div>
      <p class="font-serif text-2xl text-cream">{info.name}</p>
      <p class="mt-3 text-sm leading-relaxed text-sand/70">{info.slogan}</p>
    </div>
    <div class="space-y-2 text-sm">
      <p class="eyebrow mb-3">Liên hệ</p>
      <p>{info.address}</p>
      <p><a href={`tel:${info.phoneRaw}`} class="hover:text-clay">Hotline: {info.phone}</a></p>
      <p><a href={`mailto:${info.email}`} class="hover:text-clay">{info.email}</a></p>
    </div>
    <div class="space-y-2 text-sm">
      <p class="eyebrow mb-3">Giờ mở cửa</p>
      {info.hours.map((h) => <p>{h.days}: <span class="text-cream">{h.time}</span></p>)}
      <div class="flex gap-4 pt-3">
        <a href={info.facebook} target="_blank" rel="noopener" class="hover:text-clay">Facebook</a>
        <a href={info.zalo} target="_blank" rel="noopener" class="hover:text-clay">Zalo</a>
      </div>
    </div>
  </div>
  <div class="border-t border-sand/10 py-5 text-center text-xs text-sand/50">
    © {year} {info.name}. Mọi quyền được bảo lưu.
  </div>
</footer>
