---
import Mandala from './Mandala.astro';
import { getLang, getInfo, getServices, ui, url, serviceUrl } from '../i18n';
const lang = getLang(Astro.url);
const t = ui(lang);
const info = getInfo(lang);
const services = getServices(lang);
const year = new Date().getFullYear();
const vi = lang === 'vi';
const followLabel = { vi: 'Theo dõi Mandala', en: 'Follow us', ja: 'フォローする', ko: '팔로우', zh: '关注我们' }[lang];
const socials = [
  { key: 'facebook', name: 'Facebook', href: info.facebook,
    icon: 'M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5V21h3z' },
  { key: 'tiktok', name: 'TikTok', href: info.tiktok,
    icon: 'M16.6 5.8A4.3 4.3 0 0 1 15.5 3h-3.1v12.4a2.6 2.6 0 1 1-2.6-2.6c.3 0 .5 0 .8.1V9.7a5.8 5.8 0 1 0 5 5.7V9.1a7.3 7.3 0 0 0 4.3 1.4V7.4a4.3 4.3 0 0 1-3.3-1.6z' },
  { key: 'instagram', name: 'Instagram', href: info.instagram,
    icon: 'M12 7.4a4.6 4.6 0 1 0 0 9.2 4.6 4.6 0 0 0 0-9.2zm0 7.6a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm4.8-8.9a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2zM20.9 8c-.1-1.4-.4-2.7-1.4-3.7S17.4 3 16 2.9C14.6 2.8 9.4 2.8 8 2.9 6.6 3 5.3 3.3 4.3 4.3S3 6.6 2.9 8c-.1 1.4-.1 6.6 0 8 .1 1.4.4 2.7 1.4 3.7s2.3 1.3 3.7 1.4c1.4.1 6.6.1 8 0 1.4-.1 2.7-.4 3.7-1.4s1.3-2.3 1.4-3.7c.1-1.4.1-6.6 0-8zm-2 9.7a3 3 0 0 1-1.7 1.7c-1.2.5-4 .4-5.2.4s-4 .1-5.2-.4a3 3 0 0 1-1.7-1.7c-.5-1.2-.4-4-.4-5.2s-.1-4 .4-5.2a3 3 0 0 1 1.7-1.7c1.2-.5 4-.4 5.2-.4s4-.1 5.2.4a3 3 0 0 1 1.7 1.7c.5 1.2.4 4 .4 5.2s.1 4-.4 5.2z' },
];
---
<footer class="relative overflow-hidden bg-espresso text-sand">
  <Mandala class="pointer-events-none absolute -right-28 -bottom-28 h-96 w-96 text-goldlight/10" />
  <div class="container-x relative grid gap-10 py-14 md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <div class="flex items-center gap-3">
        <img src="/logo-mandala.svg" alt="" width="56" height="56" class="h-14 w-14" loading="lazy" />
        <div>
          <p class="font-serif text-2xl tracking-[0.1em] text-cream">MANDALA</p>
          <p class="text-xs tracking-[0.2em] text-goldlight uppercase">Healthcare & Spa</p>
        </div>
      </div>
      <p class="mt-5 font-serif text-xl text-goldlight">{info.tagline}</p>
      <p class="mt-2 text-[15px] text-sand/70">{info.tagline2}</p>
      <!-- Mạng xã hội (link trong src/data/info.json: facebook, tiktok, instagram) -->
      <p class="mt-7 mb-3 text-[13px] font-medium tracking-[0.18em] text-goldlight uppercase">{followLabel}</p>
      <ul class="flex gap-3">
        {socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener" aria-label={`${s.name} Mandala`} title={s.name} data-social={s.key}
               class="flex h-11 w-11 items-center justify-center rounded-full border border-goldlight/40 text-goldlight transition hover:border-cream hover:bg-cream hover:text-espresso">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.icon} /></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="md:col-span-3">
      <p class="mb-4 text-[13px] font-medium tracking-[0.18em] text-goldlight uppercase">{t.nav.services}</p>
      <ul class="space-y-2 text-[15px]">
        {services.groups.map((g) => <li><a href={serviceUrl(lang, g.slug)} class="hover:text-cream">{g.title}</a></li>)}
        <li><a href={url(lang, 'prices')} class="hover:text-cream">{t.nav.prices}</a></li>
      </ul>
      {vi && (
        <>
          <p class="mt-7 mb-3 text-[13px] font-medium tracking-[0.18em] text-goldlight uppercase">Tại Buôn Ma Thuột</p>
          <ul class="space-y-2 text-[15px]">
            <li><a href="/massage-buon-ma-thuot/" class="hover:text-cream">Massage Buôn Ma Thuột</a></li>
            <li><a href="/goi-dau-duong-sinh-buon-ma-thuot/" class="hover:text-cream">Gội đầu dưỡng sinh Buôn Ma Thuột</a></li>
          </ul>
        </>
      )}
    </div>

    <div class="space-y-2 text-[15px] md:col-span-5">
      <p class="mb-4 text-[13px] font-medium tracking-[0.18em] text-goldlight uppercase">{t.nav.contact}</p>
      <p><a href={info.mapLink} target="_blank" rel="noopener" class="hover:text-cream">{info.address}</a></p>
      {lang !== 'vi' && <p class="text-sand/70" lang="vi">86 Hàn Mặc Tử, Phường Buôn Ma Thuột, Đắk Lắk</p>}
      <p>{t.hotlineZalo}: <a href={`tel:${info.phoneRaw}`} class="font-medium text-cream">{info.phone}</a></p>
      {info.hours.map((h) => <p>{h.days}: <span class="text-cream">{h.time}</span></p>)}
      <div class="flex flex-wrap gap-x-5 gap-y-2 pt-3">
        <a href={info.zalo} target="_blank" rel="noopener" class="underline-offset-4 hover:text-cream hover:underline">Zalo</a>
        <a href={info.mapLink} target="_blank" rel="noopener" class="underline-offset-4 hover:text-cream hover:underline">Google Maps</a>
      </div>
    </div>
  </div>
  <div class="relative border-t border-sand/10">
    <div class="container-x flex flex-col gap-2 py-5 text-[13px] text-sand/60 md:flex-row md:justify-between">
      <p>© {year} {info.name}</p>
      <p class="flex gap-4"><a href={url(lang, 'faq')} class="hover:text-cream">{t.nav.faq}</a><a href={url(lang, 'policy')} class="hover:text-cream">{t.nav.policy}</a></p>
    </div>
  </div>
</footer>
