---
// Nút liên hệ nổi góc phải màn hình: Gọi – Zalo – Messenger
import info from '../data/info.json';
---
<div class="fixed right-4 bottom-4 z-50 flex flex-col gap-3">
  <a href={info.messenger} target="_blank" rel="noopener" aria-label="Nhắn Messenger"
     class="flex h-12 w-12 items-center justify-center rounded-full bg-[#0084ff] text-white shadow-lg transition hover:scale-105">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.4 2 2 6.1 2 11.4c0 2.9 1.4 5.5 3.6 7.2V22l3.3-1.8c.9.2 1.9.4 3.1.4 5.6 0 10-4.1 10-9.2S17.6 2 12 2zm1 12.4-2.6-2.7-5 2.7 5.5-5.8 2.6 2.7 4.9-2.7-5.4 5.8z"/></svg>
  </a>
  <a href={info.zalo} target="_blank" rel="noopener" aria-label="Chat Zalo"
     class="flex h-12 w-12 items-center justify-center rounded-full bg-[#0068ff] text-xs font-bold text-white shadow-lg transition hover:scale-105">
    Zalo
  </a>
  <a href={`tel:${info.phoneRaw}`} aria-label="Gọi hotline"
     class="flex h-12 w-12 animate-pulse items-center justify-center rounded-full bg-bark text-cream shadow-lg transition hover:scale-105">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
  </a>
</div>
