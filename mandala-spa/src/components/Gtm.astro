---
// Google Tag Manager – mã lấy từ src/data/info.json (gtmId). Đoạn mã chuẩn của Google.
// Đặt <Gtm /> đầu <head>, <Gtm noscript /> ngay sau <body>.
import info from '../data/info.json';
interface Props { noscript?: boolean }
const { noscript = false } = Astro.props;
const id = info.gtmId;
---
{id && !noscript && (
  <script is:inline define:vars={{ id }}>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',id);
  </script>
)}
{id && noscript && (
  <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${id}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
)}
