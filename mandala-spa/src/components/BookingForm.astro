---
// Form đặt lịch → gửi tới /api/booking (worker/index.js) → báo về Telegram + lưu Google Sheets
import { getLang, getInfo, getServices, ui } from '../i18n';
const lang = getLang(Astro.url);
const t = ui(lang);
const info = getInfo(lang);
const services = getServices(lang);
// Ô dịch vụ: giá trị gửi đi luôn là tên tiếng Việt (để lễ tân đọc), chữ hiển thị theo ngôn ngữ khách
const label = (i: { name: string; viName: string }) => (lang === 'vi' ? i.name : `${i.name} (${i.viName})`);

const siteKey = info.turnstileSiteKey;
const toMin = (t: string) => Number(t.split(':')[0]) * 60 + Number(t.split(':')[1]);
const times: string[] = [];
for (let m = toMin(info.bookingFirstSlot); m <= toMin(info.bookingLastSlot); m += 30) {
  times.push(`${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`);
}
---
<form id="booking-form" class="grid gap-4 sm:grid-cols-2" novalidate data-lang={lang}
      data-msg={JSON.stringify({ errName: t.form.errName, errPhone: t.form.errPhone, sending: t.form.sending, success: t.form.success, fail: t.form.fail })}>
  <label>
    <span class="mb-1.5 block text-sm font-medium text-cocoa">{t.form.name}</span>
    <input name="name" required class="field" autocomplete="name" maxlength="80" />
  </label>
  <label>
    <span class="mb-1.5 block text-sm font-medium text-cocoa">{t.form.phone}</span>
    <input name="phone" type="tel" required class="field" autocomplete="tel" inputmode="tel" maxlength="20" placeholder={t.form.phonePlaceholder || undefined} />
  </label>
  <label class="sm:col-span-2">
    <span class="mb-1.5 block text-sm font-medium text-cocoa">{t.form.service}</span>
    <select name="service" class="field">
      <option value="">{t.form.serviceNone}</option>
      {services.groups.map((g) => (
        <optgroup label={g.title}>
          {g.items.map((i) => <option value={i.viName}>{label(i)}</option>)}
        </optgroup>
      ))}
      <optgroup label={t.prices.combo}>
        {services.combos.map((c) => <option value={c.viName}>{label(c)}</option>)}
      </optgroup>
    </select>
  </label>
  <label>
    <span class="mb-1.5 block text-sm font-medium text-cocoa">{t.form.date}</span>
    <input name="date" type="date" class="field" />
  </label>
  <div class="grid grid-cols-2 gap-4">
    <label>
      <span class="mb-1.5 block text-sm font-medium text-cocoa">{t.form.time}</span>
      <select name="time" class="field">{times.map((t) => <option>{t}</option>)}</select>
    </label>
    <label>
      <span class="mb-1.5 block text-sm font-medium text-cocoa">{t.form.guests}</span>
      <input name="guests" type="number" min="1" max="10" value="1" class="field" inputmode="numeric" />
    </label>
  </div>
  <label class="sm:col-span-2">
    <span class="mb-1.5 block text-sm font-medium text-cocoa">{t.form.note}</span>
    <textarea name="note" rows="3" class="field" maxlength="500" placeholder={t.form.notePlaceholder}></textarea>
  </label>

  <!-- Bẫy bot: người thật không nhìn thấy ô này -->
  <input name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

  {siteKey && <div class="cf-turnstile sm:col-span-2" data-sitekey={siteKey} data-language={lang}></div>}

  <div class="sm:col-span-2">
    <button type="submit" class="btn-primary w-full sm:w-auto">{t.form.submit}</button>
    <p id="booking-msg" class="mt-3 text-[15px]" role="status" aria-live="polite"></p>
    <p class="mt-2 text-sm text-muted">{t.form.confirm.replace('{hours}', info.hoursShort)} <a class="font-medium text-cocoa" href={`tel:${info.phoneRaw}`}>{info.phone}</a>{t.form.confirmEnd}</p>
  </div>
</form>

{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  const form = document.getElementById('booking-form') as HTMLFormElement | null;
  const msg = document.getElementById('booking-msg');
  const M = JSON.parse(form?.dataset.msg || '{}');

  // Ngày mặc định = hôm nay, không chọn được ngày đã qua
  const dateInput = form?.querySelector<HTMLInputElement>('input[name="date"]');
  if (dateInput) {
    const d = new Date();
    d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
    dateInput.min = dateInput.value = d.toISOString().slice(0, 10);
  }

  // Chọn sẵn dịch vụ khi đến từ nút "Đặt lịch" ở bảng giá (?dv=Tên dịch vụ)
  const dv = new URLSearchParams(location.search).get('dv');
  const select = form?.querySelector<HTMLSelectElement>('select[name="service"]');
  if (dv && select) {
    const opt = Array.from(select.options).find((o) => o.value === dv || o.text === dv);
    if (opt) opt.selected = true;
  }

  const show = (text: string, ok: boolean) => {
    if (!msg) return;
    msg.textContent = text;
    msg.className = 'mt-3 text-[15px] font-medium ' + (ok ? 'text-sage' : 'text-clay');
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form).entries());
    data.page = location.pathname + location.search;
    data.lang = form.dataset.lang || 'vi';
    if (!String(data.name).trim()) return show(M.errName, false);
    if (!/^[0-9+\s.-]{8,20}$/.test(String(data.phone).trim())) return show(M.errPhone, false);

    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    show(M.sending, true);
    try {
      const res = await fetch('/api/booking', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(data),
      });
      const out = await res.json();
      if (!out.ok) throw new Error(out.error);
      form.reset();
      if (dateInput) dateInput.value = dateInput.min;
      show(M.success, true);
      // @ts-ignore – sự kiện chuyển đổi cho Tag Manager / Google Ads / Meta
      (window.dataLayer = window.dataLayer || []).push({ event: 'generate_lead', form: 'dat_lich', service: data.service || '', language: data.lang });
    } catch (err) {
      show((data.lang === 'vi' && (err as Error).message) || M.fail, false);
    } finally {
      btn.disabled = false;
      // @ts-ignore – làm mới Turnstile nếu có
      window.turnstile?.reset?.();
    }
  });
</script>
