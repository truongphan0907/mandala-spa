---
// Form đặt lịch → gửi tới /api/booking (worker/index.js) → báo về Telegram
import info from '../data/info.json';
import services from '../data/services.json';

const siteKey = info.turnstileSiteKey;
const toMin = (t: string) => Number(t.split(':')[0]) * 60 + Number(t.split(':')[1]);
const times: string[] = [];
for (let m = toMin(info.bookingFirstSlot); m <= toMin(info.bookingLastSlot); m += 30) {
  times.push(`${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`);
}
---
<form id="booking-form" class="grid gap-4 sm:grid-cols-2" novalidate>
  <label>
    <span class="mb-1.5 block text-sm font-medium text-cocoa">Họ và tên *</span>
    <input name="name" required class="field" autocomplete="name" maxlength="80" />
  </label>
  <label>
    <span class="mb-1.5 block text-sm font-medium text-cocoa">Số điện thoại *</span>
    <input name="phone" type="tel" required class="field" autocomplete="tel" inputmode="tel" maxlength="20" />
  </label>
  <label class="sm:col-span-2">
    <span class="mb-1.5 block text-sm font-medium text-cocoa">Dịch vụ</span>
    <select name="service" class="field">
      <option value="">Chưa chọn – nhờ Mandala tư vấn</option>
      {services.groups.map((g) => (
        <optgroup label={g.title}>
          {g.items.map((i) => <option>{i.name}</option>)}
        </optgroup>
      ))}
      <optgroup label="Combo">
        {services.combos.map((c) => <option>{c.name}</option>)}
      </optgroup>
    </select>
  </label>
  <label>
    <span class="mb-1.5 block text-sm font-medium text-cocoa">Ngày</span>
    <input name="date" type="date" class="field" />
  </label>
  <div class="grid grid-cols-2 gap-4">
    <label>
      <span class="mb-1.5 block text-sm font-medium text-cocoa">Giờ</span>
      <select name="time" class="field">{times.map((t) => <option>{t}</option>)}</select>
    </label>
    <label>
      <span class="mb-1.5 block text-sm font-medium text-cocoa">Số khách</span>
      <input name="guests" type="number" min="1" max="10" value="1" class="field" inputmode="numeric" />
    </label>
  </div>
  <label class="sm:col-span-2">
    <span class="mb-1.5 block text-sm font-medium text-cocoa">Ghi chú</span>
    <textarea name="note" rows="3" class="field" maxlength="500" placeholder="Vùng đau mỏi cần chú ý, muốn phòng đôi…"></textarea>
  </label>

  <!-- Bẫy bot: người thật không nhìn thấy ô này -->
  <input name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

  {siteKey && <div class="cf-turnstile sm:col-span-2" data-sitekey={siteKey} data-language="vi"></div>}

  <div class="sm:col-span-2">
    <button type="submit" class="btn-primary w-full sm:w-auto">Gửi yêu cầu đặt lịch</button>
    <p id="booking-msg" class="mt-3 text-[15px]" role="status" aria-live="polite"></p>
    <p class="mt-2 text-sm text-muted">Mandala sẽ gọi xác nhận trong giờ mở cửa ({info.hoursShort}). Cần gấp? Gọi <a class="font-medium text-cocoa" href={`tel:${info.phoneRaw}`}>{info.phone}</a>.</p>
  </div>
</form>

{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  const form = document.getElementById('booking-form') as HTMLFormElement | null;
  const msg = document.getElementById('booking-msg');

  // Ngày mặc định = hôm nay, không chọn được ngày đã qua
  const dateInput = form?.querySelector<HTMLInputElement>('input[name="date"]');
  if (dateInput) {
    const d = new Date();
    d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
    dateInput.min = dateInput.value = d.toISOString().slice(0, 10);
  }

  // Chọn sẵn dịch vụ khi đến từ nút "Đặt lịch" ở bảng giá (?dv=Tên dịch vụ)
  const dv = new URLSearchParams(location.search).get('dv');
  const select = form?.querySelector<HTMLSelectElement>('select[name="service"]');
  if (dv && select) {
    const opt = Array.from(select.options).find((o) => o.text === dv);
    if (opt) opt.selected = true;
  }

  const show = (text: string, ok: boolean) => {
    if (!msg) return;
    msg.textContent = text;
    msg.className = 'mt-3 text-[15px] font-medium ' + (ok ? 'text-sage' : 'text-clay');
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form).entries());
    if (!String(data.name).trim()) return show('Vui lòng nhập họ tên.', false);
    if (!/^[0-9+\s.-]{8,20}$/.test(String(data.phone).trim())) return show('Vui lòng nhập số điện thoại hợp lệ.', false);

    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    show('Đang gửi…', true);
    try {
      const res = await fetch('/api/booking', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(data),
      });
      const out = await res.json();
      if (!out.ok) throw new Error(out.error);
      form.reset();
      if (dateInput) dateInput.value = dateInput.min;
      show('Cảm ơn bạn! Mandala sẽ gọi xác nhận lịch hẹn trong ít phút.', true);
      // @ts-ignore – sự kiện chuyển đổi cho Tag Manager / Google Ads / Meta
      (window.dataLayer = window.dataLayer || []).push({ event: 'generate_lead', form: 'dat_lich', service: data.service || '' });
    } catch (err) {
      show((err as Error).message || 'Chưa gửi được, vui lòng gọi hotline.', false);
    } finally {
      btn.disabled = false;
      // @ts-ignore – làm mới Turnstile nếu có
      window.turnstile?.reset?.();
    }
  });
</script>
