---
// Carousel video 9:16 – điện thoại: lướt ngang; máy tính: 4 thẻ + nút trái/phải
import VideoCard from './VideoCard.astro';
import { getLang, getVideos, ui } from '../i18n';
interface Props { ids?: string[]; homeOnly?: boolean }
const { ids, homeOnly = false } = Astro.props;
const lang = getLang(Astro.url);
const t = ui(lang);
const allVideos = getVideos(lang);
const list = ids ? ids.map((i) => allVideos.find((v) => v.id === i)!).filter(Boolean) : allVideos.filter((v) => !homeOnly || v.home);
const uid = 'vc-' + Math.random().toString(36).slice(2, 8);
---
<div class="relative" data-carousel={uid}>
  <div class="no-scrollbar flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-px-5 px-5 pb-2 md:gap-5 lg:scroll-px-0 lg:px-0" data-track-el>
    {list.map((v) => (
      <div class="w-[62%] shrink-0 snap-start sm:w-[38%] md:w-[30%] lg:w-[calc((100%-60px)/4)]">
        <VideoCard id={v.id} title={v.title} label={v.label} />
      </div>
    ))}
  </div>
  {list.length > 4 && (
    <div class="mt-6 hidden justify-end gap-2 lg:flex">
      <button type="button" class="btn-ghost !min-h-11 !w-11 !px-0" data-dir="-1" aria-label={t.video.prev}>←</button>
      <button type="button" class="btn-ghost !min-h-11 !w-11 !px-0" data-dir="1" aria-label={t.video.next}>→</button>
    </div>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track-el]');
    root.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((b) =>
      b.addEventListener('click', () => track?.scrollBy({ left: Number(b.dataset.dir) * track.clientWidth * 0.75, behavior: 'smooth' })),
    );
  });
</script>
