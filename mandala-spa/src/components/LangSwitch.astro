---
// Nút chọn ngôn ngữ – chuyển sang đúng trang tương ứng (trang chỉ có tiếng Việt như Blog thì về trang chủ ngôn ngữ đó)
import { ENABLED, LANG_META, alternates, getLang, url, ui } from '../i18n';
interface Props { variant?: 'header' | 'list' }
const { variant = 'header' } = Astro.props;
const lang = getLang(Astro.url);
const alt = alternates(Astro.url.pathname);
const inBlog = /\/blog\//.test(Astro.url.pathname);
const links = ENABLED.map((l) => ({ l, href: alt?.[l] ?? url(l, inBlog ? 'blog' : 'home'), ...LANG_META[l] }));
const t = ui(lang);
---
{ENABLED.length > 1 && (variant === 'header' ? (
  <details class="lang-switch relative">
    <summary class="flex h-10 cursor-pointer list-none items-center gap-1 rounded-full border border-line px-2.5 text-sm font-medium text-cocoa sm:border-0 hover:bg-sand md:h-11 [&::-webkit-details-marker]:hidden"
             aria-label={t.language}>
      <svg class="hidden sm:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18"/></svg>
      {LANG_META[lang].short}
    </summary>
    <ul class="absolute right-0 z-50 mt-2 min-w-40 overflow-hidden rounded-2xl border border-line bg-ivory py-1 shadow-xl shadow-espresso/10">
      {links.map((x) => (
        <li><a href={x.href} hreflang={x.html} lang={x.html} aria-current={x.l === lang ? 'true' : undefined}
               class:list={['block px-4 py-2.5 text-[15px] hover:bg-sand', x.l === lang ? 'font-medium text-bronze' : 'text-ink']}>{x.label}</a></li>
      ))}
    </ul>
  </details>
) : (
  <div class="flex flex-wrap gap-2 py-3" aria-label={t.language}>
    {links.map((x) => (
      <a href={x.href} hreflang={x.html} lang={x.html}
         class:list={['rounded-full border px-3.5 py-1.5 text-sm', x.l === lang ? 'border-cocoa bg-cocoa text-cream' : 'border-line text-cocoa']}>{x.label}</a>
    ))}
  </div>
))}

<script>
  // Đóng menu ngôn ngữ khi bấm ra ngoài
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('details.lang-switch[open]').forEach((d) => {
      if (!d.contains(e.target as Node)) d.open = false;
    });
  });
</script>
