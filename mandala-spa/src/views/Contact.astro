---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import BookingForm from '../components/BookingForm.astro';
import { getLang, getInfo, ui } from '../i18n';
const lang = getLang(Astro.url);
const vi = lang === 'vi';
const t = ui(lang);
const info = getInfo(lang);
const desc = t.contact.seoDesc.replace('{address}', info.address).replace('{phone}', info.phone).replace('{hours}', info.hoursShort);
---
<Base title={t.contact.seoTitle}
      description={desc}>
  <PageHero eyebrow={t.contact.eyebrow} title={t.contact.title}
            text={t.contact.text} />

  <section class="section">
    <div class="container-x grid gap-10 lg:grid-cols-[1.3fr_1fr] lg:gap-14">
      <div id="dat-lich" class="scroll-mt-24 rounded-[2rem] border border-line bg-ivory p-6 md:p-10">
        <h2 class="text-[32px]">{t.contact.formTitle}</h2>
        <p class="mt-1 mb-8 text-[15px] text-muted">{t.contact.required}</p>
        <BookingForm />
      </div>

      <div class="space-y-8">
        <div>
          <p class="eyebrow">{t.contact.address}</p>
          <p class="mt-2 text-lg"><a href={info.mapLink} target="_blank" rel="noopener" class="underline decoration-1 underline-offset-4 hover:opacity-80">{info.address}</a></p>
          {!vi && (
            <div class="mt-3 rounded-2xl border border-gold/40 bg-sand/50 p-4">
              <p class="text-sm text-muted">{t.contact.driver}</p>
              <p class="mt-1 font-serif text-xl text-cocoa" lang="vi">86 Hàn Mặc Tử, Phường Buôn Ma Thuột, Đắk Lắk</p>
            </div>
          )}
          {!vi && <p class="mt-3 text-[15px] text-muted">🅿️ {t.contact.parking}</p>}
          <a href={info.mapLink} target="_blank" rel="noopener" class="mt-1 inline-block font-medium text-bronze underline-offset-4 hover:underline">{t.contact.directions}</a>
        </div>
        <div>
          <p class="eyebrow">{t.contact.hours}</p>
          {info.hours.map((h) => <p class="mt-2 text-lg">{h.days}: <strong class="font-medium text-cocoa">{h.time}</strong></p>)}
        </div>
        <div>
          <p class="eyebrow">{t.contact.quick}</p>
          <div class="mt-3 flex flex-wrap gap-2">
            <a href={`tel:${info.phoneRaw}`} class="btn-primary">{t.call} {info.phone}</a>
            <a href={info.zalo} target="_blank" rel="noopener" class="btn-ghost">Zalo</a>
            <a href={info.messenger} target="_blank" rel="noopener" class="btn-ghost">Messenger</a>
            <a href={info.facebook} target="_blank" rel="noopener" class="btn-ghost">Facebook</a>
          </div>
        </div>
        <iframe src={info.mapEmbedUrl} title={t.home.mapTitle} class="aspect-[4/3] w-full rounded-2xl border-0 bg-sand"
                loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>
</Base>
