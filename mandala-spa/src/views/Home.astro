---
import { Picture, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
// Trang chủ – dùng chung cho mọi ngôn ngữ (chữ lấy theo ngôn ngữ của đường dẫn)
import Base from '../layouts/Base.astro';
import Mandala from '../components/Mandala.astro';
import ServiceCard from '../components/ServiceCard.astro';
import BookingForm from '../components/BookingForm.astro';
import VideoCarousel from '../components/VideoCarousel.astro';
import VideoCard from '../components/VideoCard.astro';
import ExpertBanner from '../components/ExpertBanner.astro';
import { img } from '../lib/site';
import { getLang, getInfo, getHome, getServices, getVideos, ui, url, serviceUrl, bookUrl, price, blogUrl } from '../i18n';

const lang = getLang(Astro.url);
const vi = lang === 'vi';
const t = ui(lang);
const info = getInfo(lang);
const home = getHome(lang);
const services = getServices(lang);
const videos = getVideos(lang);
const vnd = (n: number) => price(lang, n, t.priceOnRequest);

const featured = services.groups.flatMap((g) => g.items.filter((i) => i.featured).map((i) => ({ ...i, group: g.title, slug: g.slug })));
// Bài blog mới: bản tiếng Việt lấy từ src/content/blog, bản nước ngoài từ src/content/blog-intl/<mã>/
const posts = (vi
  ? (await getCollection('blog', ({ data }) => !data.draft)).map((p) => ({ href: `/blog/${p.id}/`, title: p.data.title, date: p.data.date }))
  : (await getCollection('blogIntl', ({ id, data }) => !data.draft && id.startsWith(lang + '/'))).map((p) => ({ href: blogUrl(lang, p.id.split('/')[1]), title: p.data.title, date: p.data.date })))
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 3);
const heroVideo = videos.find((v) => v.id === home.heroVideo);
const rating = info.googleRating;

// Ảnh hero: bản dọc cho điện thoại, bản ngang cho máy tính (cùng 1 ảnh, cắt khác nhau)
const heroImg = img(home.heroImage)!;
const crop = (w: number, ratio: number, format: 'avif' | 'webp' | 'jpg', position = 'center') =>
  getImage({ src: heroImg, width: w, height: Math.round(w * ratio), fit: 'cover', position, format });
const set = async (ws: number[], ratio: number, format: 'avif' | 'webp' | 'jpg', position?: string) =>
  (await Promise.all(ws.map(async (w) => `${(await crop(w, ratio, format, position)).src} ${w}w`))).join(', ');
const mob = { avif: await set([480, 800, 1080], 1.7, 'avif'), webp: await set([480, 800, 1080], 1.7, 'webp') };
const desk = { avif: await set([800, 1200, 1600], 0.85, 'avif'), webp: await set([800, 1200, 1600], 0.85, 'webp') };
const fallback = await crop(1200, 0.85, 'jpg');
---
<Base>
  <!-- 1. HERO -->
  <section class="relative isolate overflow-hidden bg-cream">
    <div class="lg:grid lg:min-h-[max(600px,calc(100svh-72px-84px))] lg:grid-cols-2">
      <!-- Ảnh -->
      <div class="absolute inset-0 -z-10 lg:relative lg:inset-auto lg:z-0 lg:order-2">
        <div id="hero-slides" class="relative h-full w-full overflow-hidden lg:absolute lg:inset-0 lg:rounded-tl-[min(22vw,320px)]" data-seconds={home.heroSlideSeconds}>
          <div class="hero-slide absolute inset-0 opacity-100 transition-opacity duration-[1200ms]">
          <picture>
          <source media="(max-width: 1023px)" type="image/avif" srcset={mob.avif} sizes="100vw" />
          <source media="(max-width: 1023px)" type="image/webp" srcset={mob.webp} sizes="100vw" />
          <source type="image/avif" srcset={desk.avif} sizes="50vw" />
          <source type="image/webp" srcset={desk.webp} sizes="50vw" />
          <img src={fallback.src} alt={home.heroImageAlt} width="1200" height="1020" loading="eager" fetchpriority="high" decoding="async"
               class="h-full w-full object-cover" />
        </picture>
          </div>
          {home.heroSlides.map((sl) => (
            <div class="hero-slide absolute inset-0 opacity-0 transition-opacity duration-[1200ms]">
              <Picture src={img(sl.src)!} alt={sl.alt} widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 50vw, 100vw"
                       formats={['avif', 'webp']} loading="lazy" decoding="async" class="h-full w-full object-cover" />
            </div>
          ))}
          <div class="absolute bottom-5 left-1/2 z-10 hidden -translate-x-1/2 gap-2 lg:flex" aria-hidden="true">
            {[0, ...home.heroSlides].map((_, i) => <span class:list={['hero-dot h-1.5 rounded-full bg-cream/90 transition-all', i === 0 ? 'w-6' : 'w-1.5 opacity-60']}></span>)}
          </div>
        </div>
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-espresso from-10% via-espresso/70 via-45% to-espresso/0 to-70% lg:hidden"></div>
        {heroVideo && (
          <div class="absolute bottom-10 -left-20 z-10 hidden w-40 rounded-[1.2rem] border-[5px] border-cream shadow-2xl shadow-espresso/30 lg:block xl:w-44">
            <VideoCard id={heroVideo.id} title={`${heroVideo.title} · 20s`} compact class="!rounded-xl" />
          </div>
        )}
      </div>

      <!-- Chữ -->
      <div class="container-x flex min-h-[calc(100svh-56px-60px)] flex-col justify-end pt-32 pb-6 lg:mr-0 lg:min-h-0 lg:max-w-[680px] lg:justify-center lg:py-12 lg:pr-20 xl:pr-28">
        <p class="text-[12px] font-medium tracking-[0.2em] text-goldlight uppercase md:text-[13px] lg:text-bronze">{info.eyebrow}</p>
        <h1 class="mt-3 text-[36px] leading-[1.2] text-cream sm:text-5xl lg:mt-5 lg:text-[clamp(46px,4.2vw,68px)] lg:text-cocoa">
          <span class="whitespace-nowrap">{t.home.heroLines[0]}</span><br />
          <span class="whitespace-nowrap">{t.home.heroLines[1]}</span><br />
          <em class="whitespace-nowrap text-goldlight lg:text-bronze">{t.home.heroLines[2]}</em>
        </h1>
        <p class="mt-6 hidden max-w-lg text-[18px] leading-relaxed text-muted lg:block">{home.heroDescription}</p>
        <ul class="mt-4 flex flex-wrap gap-2 lg:mt-6">
          {home.heroChips.map((c) => (
            <li class="rounded-full bg-cream/15 px-3 py-1.5 text-[13px] text-cream backdrop-blur lg:bg-sand lg:px-3.5 lg:text-sm lg:text-cocoa">{c}</li>
          ))}
        </ul>
        <div class="mt-5 grid grid-cols-2 gap-3 sm:flex lg:mt-8">
          <a href={bookUrl(lang)} class="btn bg-goldlight text-espresso hover:bg-cream lg:bg-cocoa lg:text-cream lg:hover:bg-espresso">{t.bookNow}</a>
          <a href={url(lang, 'prices')} class="btn-light lg:border-cocoa/35 lg:text-cocoa lg:hover:bg-cocoa lg:hover:text-cream">{t.viewPrices}</a>
        </div>
        {rating && (
          <a href={info.mapLink} target="_blank" rel="noopener" class="mt-4 flex items-center gap-2 text-sm text-sand lg:mt-6 lg:text-[15px] lg:text-muted">
            <span class="tracking-[2px] text-goldlight lg:text-gold" aria-hidden="true">★★★★★</span>
            <span>{rating}/5 · {info.googleReviewCount} {t.rating.reviews}</span>
          </a>
        )}
      </div>
    </div>

    <!-- Dải thông tin nhanh (desktop) -->
    <div class="hidden border-t border-line bg-ivory lg:block">
      <div class="container-x grid h-[84px] grid-cols-4 divide-x divide-line text-[15px]">
        <a href={info.mapLink} target="_blank" rel="noopener" class="flex flex-col justify-center pr-4 hover:text-bronze"><span class="text-xs text-muted">{t.home.address}</span>{info.addressShort}</a>
        <p class="flex flex-col justify-center px-6"><span class="text-xs text-muted">{t.home.openDaily}</span>{info.hoursShort}</p>
        <a href={`tel:${info.phoneRaw}`} class="flex flex-col justify-center px-6 hover:text-bronze"><span class="text-xs text-muted">{t.hotlineZalo}</span><span class="font-medium">{info.phone}</span></a>
        <a href={info.mapLink} target="_blank" rel="noopener" class="flex flex-col justify-center px-6 hover:text-bronze">
          <span class="text-xs text-muted">{t.rating.google}</span>{rating ? `★ ${rating} · ${info.googleReviewCount} ${t.rating.reviewsShort}` : t.rating.seeFeedback}
        </a>
      </div>
    </div>
  </section>

  <ExpertBanner />

  <script>
    // Ảnh hero tự chuyển (thời gian: heroSlideSeconds trong src/data/home.json)
    const box = document.getElementById('hero-slides');
    const slides = Array.from(box?.querySelectorAll<HTMLElement>('.hero-slide') ?? []);
    const dots = Array.from(box?.querySelectorAll<HTMLElement>('.hero-dot') ?? []);
    // Chỉ dừng khi khách bật "tiết kiệm dữ liệu"; hiệu ứng mờ dần nhẹ nên vẫn chạy với chế độ giảm chuyển động
    // @ts-ignore
    const saveData = navigator.connection?.saveData === true;
    if (box && slides.length > 1 && !saveData) {
      let i = 0;
      const ms = Math.max(2, Number(box.dataset.seconds) || 4) * 1000;
      const go = () => {
        if (document.hidden) return;
        slides[i].classList.replace('opacity-100', 'opacity-0');
        dots[i]?.classList.replace('w-6', 'w-1.5'); dots[i]?.classList.add('opacity-60');
        i = (i + 1) % slides.length;
        slides[i].classList.replace('opacity-0', 'opacity-100');
        dots[i]?.classList.replace('w-1.5', 'w-6'); dots[i]?.classList.remove('opacity-60');
      };
      // Bắt đầu chuyển sau khi trang tải xong, để ảnh đầu tiên hiện nhanh nhất
      const start = () => setInterval(go, ms);
      if (document.readyState === 'complete') start();
      else window.addEventListener('load', start, { once: true });
    }
  </script>

  <!-- 3. VIDEO -->
  <section class="section">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div class="max-w-2xl">
          <p class="eyebrow">{t.video.eyebrow}</p>
          <h2 class="h2 mt-3">{home.videosTitle}</h2>
          <p class="mt-3 text-muted">{home.videosIntro}</p>
        </div>
        <a href={info.facebook} target="_blank" rel="noopener" class="text-[15px] font-medium text-cocoa underline-offset-4 hover:underline">{t.video.moreFb}</a>
      </div>
    </div>
    <div class="mt-8 md:container-x md:mt-10"><VideoCarousel homeOnly /></div>
  </section>

  <!-- 4. BỐN TRỤ CỘT DỊCH VỤ -->
  <section class="section bg-sand/60">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow">{t.home.servicesEyebrow}</p>
        <h2 class="h2 mt-3">{home.pillarsTitle}</h2>
        <p class="mt-4 text-muted">{home.pillarsIntro}</p>
      </div>
    </div>
    <div class="no-scrollbar mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-px-5 px-5 pb-2 md:container-x md:mt-12 md:grid md:grid-cols-2 md:gap-6 md:overflow-visible md:pb-0 lg:grid-cols-4">
      {services.groups.map((g) => (
        <div class="w-[78%] shrink-0 snap-start sm:w-[46%] md:w-auto"><ServiceCard group={g} /></div>
      ))}
    </div>
  </section>

  <!-- 5. LIỆU PHÁP ĐẶC TRƯNG -->
  <section class="section">
    <div class="container-x grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="grid grid-cols-[1fr_0.62fr] items-end gap-3 md:gap-5">
        <Picture src={img(home.signature.image)!} alt={home.signature.imageAlt} widths={[400, 700, 1000]} sizes="(min-width: 1024px) 340px, 60vw"
                 formats={['avif', 'webp']} class="aspect-[4/5] w-full rounded-[1.6rem] object-cover" />
        <div class="flex flex-col gap-3 md:gap-5">
          <Picture src={img(home.signature.secondImage)!} alt={home.signature.secondAlt} widths={[300, 500]} sizes="(min-width: 1024px) 210px, 36vw"
                   formats={['avif', 'webp']} class="aspect-square w-full rounded-[1.2rem] object-cover" />
          <VideoCard id={home.signature.video} title={t.video.copper} compact />
        </div>
      </div>
      <div>
        <p class="eyebrow">{home.signature.eyebrow}</p>
        <h2 class="h2 mt-3">{home.signature.title}</h2>
        <p class="mt-5 text-muted">{home.signature.text}</p>
        <ul class="mt-6 space-y-3">
          {home.signature.points.map((p) => (
            <li class="flex gap-3"><Mandala class="mt-1 h-5 w-5 shrink-0 text-gold" petals={8} stroke={7} /><span>{p}</span></li>
          ))}
        </ul>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={serviceUrl(lang, 'dong-y-duong-sinh')} class="btn-primary">{t.home.sigBtn1}</a>
          <a href={vi ? '/blog/tri-lieu-co-vai-gay-chuyen-sau/' : url(lang, 'prices')} class="btn-ghost">{t.home.sigBtn2}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. KHÁCH HÀNG NÓI GÌ -->
  <section class="section bg-espresso text-cream">
    <div class="container-x grid items-center gap-10 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
      <div>
        <p class="text-[13px] font-medium tracking-[0.18em] text-goldlight uppercase">{t.home.reviewsEyebrow}</p>
        <h2 class="h2 mt-3 text-cream">{home.reviewsTitle}</h2>
        {rating && (
          <div class="mt-6 flex items-end gap-4">
            <span class="font-serif text-6xl leading-none text-goldlight md:text-7xl">{rating}</span>
            <span class="pb-1"><span class="block tracking-[3px] text-goldlight" aria-label={`${rating} ${t.rating.of5}`}>★★★★★</span><span class="text-sand/80">{info.googleReviewCount} {t.rating.reviews}</span></span>
          </div>
        )}
        <p class="mt-5 max-w-lg text-sand/80">{home.reviewsIntro}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={info.mapLink} target="_blank" rel="noopener" class="btn bg-goldlight text-espresso hover:bg-cream">{t.rating.read}</a>
          <a href={info.facebook} target="_blank" rel="noopener" class="btn-light">{t.rating.follow}</a>
        </div>
      </div>
      {home.reviews.length > 0 ? (
        <div class="grid gap-4">
          {home.reviews.map((r: { name: string; text: string }) => (
            <figure class="rounded-2xl bg-cream/5 p-6 ring-1 ring-cream/10">
              <p class="tracking-[2px] text-goldlight" aria-label={t.rating.stars5}>★★★★★</p>
              <blockquote class="mt-3 font-serif text-xl leading-snug">“{r.text}”</blockquote>
              <figcaption class="mt-4 text-sm text-sand/70">— {r.name}</figcaption>
            </figure>
          ))}
        </div>
      ) : home.reviewsImage ? (
        <Picture src={img(home.reviewsImage)!} alt={t.home.reviewsAlt} widths={[480, 800]} sizes="(min-width: 1024px) 560px, 100vw"
                 formats={['avif', 'webp']} class="aspect-[4/3] w-full rounded-[2rem] object-cover" />
      ) : (
        <div class="grid grid-cols-2 gap-3 md:gap-4">
          {['sanh-cho.jpg', 'tra-gung-don-khach.jpg'].map((s, i) => (
            <Picture src={img(s)!} alt={i ? t.home.teaAlt : t.home.lobbyAlt} widths={[300, 600]} sizes="(min-width: 1024px) 300px, 50vw"
                     formats={['avif', 'webp']} class:list={['w-full rounded-2xl object-cover', i ? 'mt-10 aspect-[3/4]' : 'aspect-[3/4]']} />
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- 7. LIỆU TRÌNH NỔI BẬT + COMBO -->
  <section class="section">
    <div class="container-x grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-14">
      <div>
        <p class="eyebrow">{t.home.featuredEyebrow}</p>
        <h2 class="h2 mt-3">{home.featuredTitle}</h2>
        <ul class="mt-8 divide-y divide-line rounded-2xl border border-line bg-ivory">
          {featured.map((f) => (
            <li class="flex items-center justify-between gap-4 px-5 py-4 md:px-6">
              <a href={serviceUrl(lang, f.slug)} class="hover:text-bronze"><span class="block text-xs tracking-[0.12em] text-muted uppercase">{f.group}</span><span class="font-medium">{f.name}</span></a>
              <span class="flex items-center gap-4">
                <span class="text-lg font-medium whitespace-nowrap text-bronze">{vnd(f.price)}</span>
                <a href={bookUrl(lang, f.viName)} class="hidden text-sm font-medium whitespace-nowrap text-cocoa underline-offset-4 hover:underline sm:inline">{t.bookArrow}</a>
              </span>
            </li>
          ))}
        </ul>
        <a href={url(lang, 'prices')} class="mt-6 inline-block font-medium text-cocoa underline underline-offset-4">{t.fullPrices}</a>
      </div>
      <div class="overflow-hidden rounded-[2rem] bg-espresso text-cream">
        <Picture src={img(home.comboImage)!} alt={home.comboImageAlt} widths={[480, 800]} sizes="(min-width: 1024px) 480px, 100vw"
                 formats={['avif', 'webp']} class="aspect-[16/10] w-full object-cover" />
        <div class="p-6 md:p-8">
          <p class="text-[13px] font-medium tracking-[0.18em] text-goldlight uppercase">{t.home.combo}</p>
          <ul class="mt-4 space-y-4">
            {services.combos.map((c) => (
              <li class="flex items-baseline justify-between gap-4 border-b border-cream/10 pb-4">
                <span class="font-serif text-xl">{c.name}</span>
                <span class="text-lg font-medium whitespace-nowrap text-goldlight">{vnd(c.price)}</span>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-[15px] text-sand/80">{t.home.comboText}</p>
          {vi
            ? <a href={info.zalo} target="_blank" rel="noopener" class="btn mt-6 bg-goldlight text-espresso hover:bg-cream">{t.consultZalo}</a>
            : <a href={bookUrl(lang)} class="btn mt-6 bg-goldlight text-espresso hover:bg-cream">{t.bookOnline}</a>}
        </div>
      </div>
    </div>
  </section>

  <!-- 8. HÀNH TRÌNH 4 BƯỚC + CAM KẾT -->
  <section class="section bg-sand/60">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow">{t.home.journeyEyebrow}</p>
        <h2 class="h2 mt-3">{home.journey.title}</h2>
      </div>
    </div>
    <ol class="no-scrollbar mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-px-5 px-5 pb-2 md:container-x md:mt-10 md:grid md:grid-cols-4 md:gap-6 md:overflow-visible">
      {home.journey.steps.map((s, i) => (
        <li class="w-[72%] shrink-0 snap-start rounded-2xl border border-line bg-ivory p-6 md:w-auto">
          <span class="flex h-11 w-11 items-center justify-center rounded-full border border-gold/60 font-serif text-xl text-bronze">{i + 1}</span>
          <h3 class="mt-4 text-[24px]">{s.title}</h3>
          <p class="mt-1 text-[15px] text-muted">{s.text}</p>
        </li>
      ))}
    </ol>
    <div class="container-x">
      <ul class="mt-8 grid gap-x-8 gap-y-3 text-[15px] sm:grid-cols-2 lg:grid-cols-4">
        {home.journey.promises.map((p) => (
          <li class="flex gap-3"><span class="text-bronze" aria-hidden="true">✓</span><span><span class="font-medium text-cocoa">{p.title}.</span> <span class="text-muted">{p.text}</span></span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 9. KHÔNG GIAN -->
  <section class="section">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow">{t.home.spaceEyebrow}</p>
        <h2 class="h2 mt-3">{home.space.title}</h2>
        <p class="mt-4 text-muted">{home.space.text}</p>
      </div>
      <div class="mt-8 grid grid-cols-2 gap-3 md:mt-12 md:grid-cols-3 md:gap-5">
        {home.space.images.map((s) => (
          <figure class="group relative overflow-hidden rounded-2xl">
            <Picture src={img(s.src)!} alt={s.alt} widths={[360, 600, 800]} sizes="(min-width: 768px) 33vw, 50vw" formats={['avif', 'webp']}
                     class="aspect-square w-full object-cover transition duration-700 group-hover:scale-105" />
            <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-espresso/80 to-transparent px-3 pt-8 pb-2.5 text-sm text-cream md:px-4 md:text-[15px]">{s.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. ĐẶT LỊCH + BẢN ĐỒ -->
  <section class="section bg-sand/60" id="dat-lich-nhanh">
    <div class="container-x grid gap-10 lg:grid-cols-[1.25fr_1fr] lg:gap-14">
      <div class="rounded-[2rem] border border-line bg-ivory p-6 md:p-10">
        <p class="eyebrow">{t.home.bookEyebrow}</p>
        <h2 class="h2 mt-3">{home.ctaTitle}</h2>
        <p class="mt-3 mb-8 text-muted">{home.ctaText}</p>
        <BookingForm />
      </div>
      <div class="flex flex-col gap-6">
        <div>
          <p class="eyebrow">{t.home.visit}</p>
          <p class="mt-3 font-serif text-2xl text-cocoa"><a href={info.mapLink} target="_blank" rel="noopener" class="underline decoration-1 underline-offset-4 hover:opacity-80">{info.address}</a></p>
          {!vi && <p class="mt-1 text-sm text-muted" lang="vi">86 Hàn Mặc Tử, Phường Buôn Ma Thuột, Đắk Lắk</p>}
          <p class="mt-2 text-muted">{info.tagline2} · {t.home.open} {info.hoursShort}</p>
          <p class="mt-1">{t.hotlineZalo}: <a href={`tel:${info.phoneRaw}`} class="font-medium text-cocoa">{info.phone}</a></p>
        </div>
        <iframe src={info.mapEmbedUrl} title={t.home.mapTitle} class="min-h-72 w-full flex-1 rounded-2xl border-0 bg-sand" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        <a href={info.mapLink} target="_blank" rel="noopener" class="btn-ghost">{t.directionsMaps}</a>
      </div>
    </div>
    {posts.length > 0 && (
      <div class="container-x mt-14 border-t border-line pt-8">
        <p class="text-sm font-medium tracking-[0.12em] text-muted uppercase">{t.home.blogNew}</p>
        <ul class="mt-3 grid gap-2 md:grid-cols-3 md:gap-6">
          {posts.map((p) => <li><a href={p.href} class="font-medium text-cocoa underline-offset-4 hover:underline">{p.title}</a></li>)}
        </ul>
      </div>
    )}
  </section>
</Base>
