---
// Trang chi tiết nhóm dịch vụ – nội dung lấy từ src/data/services.json (và bản dịch src/data/<mã>/services.json)
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PriceList from '../components/PriceList.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Mandala from '../components/Mandala.astro';
import VideoCarousel from '../components/VideoCarousel.astro';
import ExpertBanner from '../components/ExpertBanner.astro';
import { Picture } from 'astro:assets';
import { img } from '../lib/site';
import { getLang, getServices, ui, url, serviceUrl, bookUrl } from '../i18n';

interface Props { slug: string }
const lang = getLang(Astro.url);
const vi = lang === 'vi';
const t = ui(lang);
const services = getServices(lang);
const g: any = services.groups.find((x) => x.slug === Astro.props.slug)!;
const others = services.groups.filter((x) => x.slug !== g.slug);
// Trang đích địa phương (chỉ tiếng Việt)
const localPage = ({
  'massage-tri-lieu': { href: '/massage-buon-ma-thuot/', text: 'Xem giá, thời lượng, đường đi và giữ phòng massage nhanh' },
  'goi-dau-duong-sinh': { href: '/goi-dau-duong-sinh-buon-ma-thuot/', text: 'So sánh 4 gói gội, xem video và giữ chỗ nhanh' },
} as Record<string, { href: string; text: string }>)[g.slug];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: g.faq.map((f: { q: string; a: string }) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base title={g.seoTitle} description={g.seoDescription} schema={faqSchema}>
  <PageHero eyebrow={g.menuName} title={g.heading} text={g.intro} image={g.heroImage || undefined} alt={g.heroAlt}
            crumbs={[{ href: url(lang, 'services'), label: t.nav.services }]}>
    <a href={bookUrl(lang)} class="btn-primary mt-7">{t.service.bookPrefix} {vi ? g.title.toLowerCase() : g.title}</a>
  </PageHero>

  <section class="section">
    <div class="container-x grid gap-8 md:grid-cols-2">
      <div class="rounded-2xl border border-line bg-ivory p-6 md:p-8">
        <h2 class="text-[28px]">{t.service.suitable}</h2>
        <ul class="mt-4 space-y-3">
          {g.suitable.map((s: string) => <li class="flex gap-3"><Mandala class="mt-1 h-5 w-5 shrink-0 text-gold" petals={8} stroke={7} />{s}</li>)}
        </ul>
      </div>
      <div class="rounded-2xl border border-line bg-ivory p-6 md:p-8">
        <h2 class="text-[28px]">{t.service.benefits}</h2>
        <ul class="mt-4 space-y-3">
          {g.benefits.map((s: string) => <li class="flex gap-3"><span class="mt-0.5 text-bronze" aria-hidden="true">✓</span>{s}</li>)}
        </ul>
      </div>
    </div>
  </section>

  {g.slug === 'dong-y-duong-sinh' && <ExpertBanner />}

  {g.videos && g.videos.length > 0 && (
    <section class="section pt-0">
      <div class="container-x"><p class="eyebrow">{t.video.eyebrow}</p><h2 class="h2 mt-3 mb-8">{t.service.videoTitle}</h2></div>
      <div class="md:container-x"><VideoCarousel ids={g.videos} /></div>
    </section>
  )}

  {g.gallery && g.gallery.length > 0 && (
    <section class="pb-14 md:pb-24">
      <div class="container-x grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-5">
        {g.gallery.map((x: any) => (
          <figure class="overflow-hidden rounded-2xl">
            <Picture src={img(x.src)!} alt={x.alt} widths={[360, 600, 800]} sizes="(min-width: 768px) 33vw, 50vw" formats={['avif', 'webp']} class="aspect-[4/5] w-full object-cover" />
            <figcaption class="pt-2 text-sm text-muted">{x.caption}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <section class="section bg-sand/60" id="bang-gia">
    <div class="container-x">
      <p class="eyebrow">{t.service.prices}</p>
      <h2 class="h2 mt-3">{t.service.listPrefix} {vi ? g.title.toLowerCase() : g.title}</h2>
      {vi && localPage && (
        <a href={localPage.href} class="mt-6 flex items-center justify-between gap-4 rounded-2xl border border-bronze/40 bg-ivory p-5 hover:border-bronze">
          <span><span class="block font-medium text-ink">Bạn ở Buôn Ma Thuột?</span><span class="text-[15px] text-muted">{localPage.text}</span></span>
          <span class="text-xl text-bronze" aria-hidden="true">→</span>
        </a>
      )}
      <div class="mt-8"><PriceList items={g.items} /></div>
    </div>
  </section>

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">{t.service.process}</p>
        <h2 class="h2 mt-3">{t.service.steps}</h2>
        <ol class="mt-8 space-y-5">
          {g.process.map((p: string, i: number) => (
            <li class="flex items-center gap-4">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-gold/60 font-serif text-lg text-bronze">{i + 1}</span>{p}
            </li>
          ))}
        </ol>
        <div class="mt-8 rounded-2xl border border-gold/40 bg-sand/50 p-5 text-[15px]">
          <p class="font-medium text-cocoa">{t.service.note}</p>
          <p class="mt-1 text-muted">{g.notes}</p>
        </div>
      </div>
      <div>
        <p class="eyebrow">{t.service.faqEyebrow}</p>
        <h2 class="h2 mt-3">{t.service.faqTitle}</h2>
        <div class="mt-8"><Faq items={g.faq} /></div>
        {vi && g.related && <a href={g.related} class="mt-6 inline-block font-medium text-cocoa underline underline-offset-4">{t.service.readMore}</a>}
      </div>
    </div>
  </section>

  <section class="pb-14 md:pb-24">
    <div class="container-x">
      <p class="text-sm font-medium tracking-[0.12em] text-muted uppercase">{t.service.others}</p>
      <div class="mt-4 grid gap-3 md:grid-cols-3">
        {others.map((o) => (
          <a href={serviceUrl(lang, o.slug)} class="rounded-2xl border border-line bg-ivory p-5 hover:border-bronze">
            <span class="font-serif text-2xl text-cocoa">{o.title}</span>
            <span class="mt-1 block text-[15px] text-muted">{o.short}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
