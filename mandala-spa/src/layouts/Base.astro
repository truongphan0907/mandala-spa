---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import DesktopFloat from '../components/DesktopFloat.astro';
import VideoModal from '../components/VideoModal.astro';
import Gtm from '../components/Gtm.astro';
import info from '../data/info.json';

interface Props {
  title?: string;          // Tiêu đề SEO (thẻ <title>)
  description?: string;    // Mô tả SEO
  ogImage?: string;        // Ảnh chia sẻ mạng xã hội (đường dẫn trong /public hoặc URL ảnh đã build)
  type?: 'website' | 'article';
  schema?: object | object[]; // Dữ liệu cấu trúc bổ sung (JSON-LD)
  noindex?: boolean;
}
const { title, description = info.description, ogImage = '/og-image.jpg', type = 'website', schema, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | Mandala` : `${info.name} Buôn Ma Thuột – ${info.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);

const business = {
  '@context': 'https://schema.org',
  '@type': 'DaySpa',
  '@id': new URL('/#spa', Astro.site).toString(),
  name: info.name,
  description: info.description,
  url: Astro.site?.toString(),
  image: new URL('/og-image.jpg', Astro.site).toString(),
  logo: new URL('/icon-512.png', Astro.site).toString(),
  telephone: info.phoneRaw,
  priceRange: '69.000đ – 999.000đ',
  address: {
    '@type': 'PostalAddress',
    streetAddress: info.street,
    addressLocality: info.city,
    addressRegion: info.region,
    postalCode: info.postalCode,
    addressCountry: 'VN',
  },
  hasMap: info.mapLink,
  openingHours: info.openingHoursSchema,
  sameAs: [info.facebook],
};
const schemas = [business, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Google Tag Manager (mã trong src/data/info.json → gtmId) -->
    <Gtm />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#3b2b20" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={info.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content="vi_VN" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class="pb-[calc(60px+env(safe-area-inset-bottom))] lg:pb-0">
    <Gtm noscript />
    <a href="#noi-dung" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:rounded focus:bg-ivory focus:px-4 focus:py-2">Bỏ qua menu</a>
    <Header />
    <main id="noi-dung">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <DesktopFloat />
    <VideoModal />
    <script is:inline>
      // Gửi sự kiện cho Tag Manager khi khách bấm Gọi / Zalo / Messenger / Facebook
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href]');
        if (!a) return;
        var h = a.getAttribute('href') || '', ev = '';
        if (h.indexOf('tel:') === 0) ev = 'click_call';
        else if (h.indexOf('zalo.me') > -1) ev = 'click_zalo';
        else if (h.indexOf('m.me') > -1) ev = 'click_messenger';
        else if (h.indexOf('/maps') > -1) ev = 'click_map';
        if (ev) (window.dataLayer = window.dataLayer || []).push({ event: ev, link_url: h });
      });
    </script>
  </body>
</html>
